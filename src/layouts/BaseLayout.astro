---
import { ClientRouter } from 'astro:transitions';
import { assetPath, SITE } from '../config';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = `${SITE.title} – ${SITE.team}`,
	description = SITE.description,
} = Astro.props;
---

<!doctype html>
<html lang="de-AT" transition:name="root" transition:animate="none">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#121212" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href={assetPath('favicon.png')} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		color: #242020;
		background: #2a1113;
		font-synthesis: none;
		--ink: #242020;
		--muted: #686061;
		--paper: #fffdf4;
		--paper-edge: #e8e0ce;
		--accent: #c51d24;
		--accent-dark: #941218;
		--black: #171515;
		--wood-dark: #321719;
		--shadow: 0 12px 24px rgb(0 0 0 / 28%), 0 2px 5px rgb(0 0 0 / 24%);
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 5.5rem;
	}

	body {
		margin: 0;
		min-width: 18rem;
		min-height: 100vh;
		overflow-x: clip;
		background-color: #3c1a1c;
		background-image:
			linear-gradient(90deg, rgb(255 255 255 / 3%) 1px, transparent 1px),
			linear-gradient(
				175deg,
				transparent 0 19%,
				rgb(0 0 0 / 14%) 19.2%,
				transparent 19.6% 47%,
				rgb(255 255 255 / 4%) 47.2%,
				transparent 47.8% 78%,
				rgb(0 0 0 / 12%) 78.2%,
				transparent 78.7%
			),
			linear-gradient(90deg, #4b2022, #2e1517 48%, #4a2022);
		background-size: 34px 100%, 100% 240px, 100% 100%;
	}

	button,
	input,
	summary {
		font: inherit;
	}

	button,
	summary,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	a {
		color: var(--accent-dark);
		text-decoration-thickness: 0.12em;
		text-underline-offset: 0.15em;
	}

	:focus-visible {
		outline: 3px solid #ffbd22;
		outline-offset: 3px;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
