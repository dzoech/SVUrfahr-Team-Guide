---
import { SITE } from '../config';
---

<header class="site-header" transition:persist="site-header">
	<a class="brand" href="/" aria-label={`${SITE.team} – Startseite`}>
		<span class="crest" aria-hidden="true">
			<span>SVU</span>
			<small>1912</small>
		</span>
		<span class="brand-copy">
			<strong>{SITE.team}</strong>
			<small>{SITE.title}</small>
		</span>
	</a>
	<a class="home-link" href="/">
		<span aria-hidden="true">⌂</span>
		<span>Start</span>
	</a>
</header>

<style>
	.site-header {
		position: sticky;
		z-index: 20;
		top: 0;
		display: flex;
		width: min(100%, 30rem);
		min-height: 4.35rem;
		padding:
			max(0.5rem, env(safe-area-inset-top))
			max(0.85rem, env(safe-area-inset-right))
			0.5rem
			max(0.85rem, env(safe-area-inset-left));
		margin-inline: auto;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		border-bottom: 3px solid var(--accent);
		color: white;
		background: rgb(18 18 18 / 96%);
		box-shadow: 0 5px 18px rgb(0 0 0 / 32%);
		backdrop-filter: blur(10px);
	}

	.brand {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.65rem;
		color: white;
		text-decoration: none;
	}

	.crest {
		display: grid;
		flex: 0 0 auto;
		width: 2.55rem;
		height: 2.8rem;
		place-content: center;
		border: 2px solid white;
		border-radius: 0.35rem 0.35rem 0.9rem 0.9rem;
		color: white;
		background: var(--accent);
		box-shadow: inset 0 0 0 2px var(--black);
		text-align: center;
		transform: skewY(-2deg);
	}

	.crest span {
		font-size: 0.72rem;
		font-weight: 950;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.crest small {
		margin-top: 0.1rem;
		font-size: 0.45rem;
		font-weight: 800;
		line-height: 1;
	}

	.brand-copy {
		min-width: 0;
	}

	.brand-copy strong,
	.brand-copy small {
		display: block;
		overflow: hidden;
		line-height: 1.15;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.brand-copy strong {
		font-size: 0.9rem;
	}

	.brand-copy small {
		margin-top: 0.12rem;
		color: rgb(255 255 255 / 67%);
		font-size: 0.68rem;
	}

	.home-link {
		display: grid;
		grid-template-columns: auto auto;
		min-height: 2.75rem;
		padding: 0.45rem 0.7rem;
		align-items: center;
		gap: 0.35rem;
		border: 1px solid rgb(255 255 255 / 25%);
		border-radius: 999px;
		color: white;
		font-size: 0.78rem;
		font-weight: 800;
		text-decoration: none;
	}

	.home-link span:first-child {
		font-size: 1.05rem;
	}
</style>
