---
import {
	FOOTBALL_QUIZ_GAME_LENGTH,
	FOOTBALL_QUIZ_QUESTIONS,
} from '../data/footballQuiz';

const firstQuestion = FOOTBALL_QUIZ_QUESTIONS[0];
const firstAnswers = [firstQuestion.correctAnswer, ...firstQuestion.wrongAnswers];
const answerLetters = ['A', 'B', 'C', 'D'];
const gameLength = FOOTBALL_QUIZ_GAME_LENGTH;
---

<section class="quiz-card" data-football-quiz>
	<div class="quiz-meta">
		<span data-question-count>Frage 1 von {gameLength}</span>
		<span class="score-counter">Punkte <strong data-score>0</strong></span>
		<span class="hold-badge" data-hold-badge><i aria-hidden="true"></i> Gedrückt halten</span>
	</div>

	<div class="question-sheet" data-question-sheet>
		<p>Fußballbegriff</p>
		<h2>Was bedeutet <mark data-question-term>{firstQuestion.term}</mark>?</h2>
	</div>

	<div class="answer-grid" data-answer-grid role="group" aria-label="Antwortmöglichkeiten">
		{firstAnswers.map((answer, index) => (
			<button
				type="button"
				class="answer-button"
				data-answer-index={index}
				aria-label={`${answerLetters[index]}: ${answer}. Gedrückt halten, um diese Antwort auszuwählen.`}
			>
				<span class="answer-letter" aria-hidden="true">{answerLetters[index]}</span>
				<span class="answer-text">{answer}</span>
			</button>
		))}
	</div>

	<p class="hold-hint" data-hold-hint>
		Halte eine Antwort gedrückt, bis das Farbfeld ganz gefüllt ist.
	</p>

	<div class="quiz-result" data-quiz-result role="status" aria-live="polite" hidden>
		<strong data-result-title></strong>
		<p data-result-explanation></p>
	</div>

	<section class="final-score" data-final-score aria-live="polite" hidden>
		<span class="score-star" aria-hidden="true">★</span>
		<p>Spiel beendet</p>
		<h2><strong data-final-score-value>0</strong> von {gameLength}</h2>
		<div data-final-score-message></div>
	</section>

	<button type="button" class="next-question" data-next-question hidden>Nächste Frage →</button>

	<div class="fireworks" data-fireworks aria-hidden="true"></div>
	<script
		type="application/json"
		data-quiz-questions
		is:inline
		set:html={JSON.stringify(FOOTBALL_QUIZ_QUESTIONS)}
	></script>
</section>

<script>
	interface QuizQuestion {
		term: string;
		difficulty: 'easy' | 'medium' | 'hard';
		correctAnswer: string;
		wrongAnswers: string[];
		explanation: string;
	}

	interface GameQuestion extends QuizQuestion {
		answers: string[];
		correctIndex: number;
	}

	interface RoundAnswer {
		selectedIndex: number;
		isCorrect: boolean;
	}

	interface StoredProgress {
		gameQuestions: GameQuestion[];
		currentRoundIndex: number;
		score: number;
		roundAnswers: Record<number, RoundAnswer>;
		finished: boolean;
	}

	const HOLD_DURATION_MS = 900;
	const RELEASE_DURATION_MS = 550;
	const GAME_LENGTH = 11;
	const QUESTIONS_PER_DIFFICULTY = {
		easy: 6,
		medium: 3,
		hard: 2,
	} satisfies Record<QuizQuestion['difficulty'], number>;
	const ANSWER_LETTERS = ['A', 'B', 'C', 'D'];
	const PROGRESS_STORAGE_KEY = 'svurfahr-football-quiz-progress-v2';

	function requireQuizElement<T extends Element>(element: T | null, selector: string): T {
		if (!element) {
			throw new Error(`The football quiz element ${selector} is missing.`);
		}

		return element;
	}

	function isQuizQuestion(value: unknown): value is QuizQuestion {
		if (typeof value !== 'object' || value === null) return false;

		const question = value as Partial<QuizQuestion>;

		return (
			typeof question.term === 'string' &&
			(question.difficulty === 'easy' ||
				question.difficulty === 'medium' ||
				question.difficulty === 'hard') &&
			typeof question.correctAnswer === 'string' &&
			Array.isArray(question.wrongAnswers) &&
			question.wrongAnswers.length === 3 &&
			question.wrongAnswers.every((answer) => typeof answer === 'string') &&
			typeof question.explanation === 'string'
		);
	}

	function isGameQuestion(value: unknown): value is GameQuestion {
		if (!isQuizQuestion(value)) return false;

		const question = value as Partial<GameQuestion>;

		return (
			Array.isArray(question.answers) &&
			question.answers.length === 4 &&
			question.answers.every((answer) => typeof answer === 'string') &&
			Number.isInteger(question.correctIndex) &&
			(question.correctIndex as number) >= 0 &&
			(question.correctIndex as number) <= 3 &&
			question.answers[question.correctIndex as number] === question.correctAnswer
		);
	}

	function shuffle<T>(values: T[]): T[] {
		for (let index = values.length - 1; index > 0; index -= 1) {
			const swapIndex = Math.floor(Math.random() * (index + 1));
			[values[index], values[swapIndex]] = [values[swapIndex], values[index]];
		}

		return values;
	}

	function createGame(questions: QuizQuestion[]): GameQuestion[] {
		const selectedQuestions = (
			Object.entries(QUESTIONS_PER_DIFFICULTY) as [
				QuizQuestion['difficulty'],
				number,
			][]
		).flatMap(([difficulty, count]) => {
			const questionsAtDifficulty = questions.filter(
				(question) => question.difficulty === difficulty,
			);

			if (questionsAtDifficulty.length < count) {
				throw new Error(
					`The football quiz needs at least ${count} ${difficulty} questions.`,
				);
			}

			return shuffle(questionsAtDifficulty).slice(0, count);
		});

		if (selectedQuestions.length !== GAME_LENGTH) {
			throw new Error(`The football quiz needs exactly ${GAME_LENGTH} questions per game.`);
		}

		return shuffle(selectedQuestions).map((question) => {
			const answers = shuffle([question.correctAnswer, ...question.wrongAnswers]);

			return {
				...question,
				answers,
				correctIndex: answers.indexOf(question.correctAnswer),
			};
		});
	}

	function initializeFootballQuizzes() {
		const quizzes = document.querySelectorAll<HTMLElement>('[data-football-quiz]');

		for (const quiz of quizzes) {
			if (quiz.dataset.initialized === 'true') continue;
			quiz.dataset.initialized = 'true';

			const questionData = requireQuizElement(
				quiz.querySelector<HTMLScriptElement>('[data-quiz-questions]'),
				'[data-quiz-questions]',
			);
			const questionCount = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-question-count]'),
				'[data-question-count]',
			);
			const scoreDisplay = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-score]'),
				'[data-score]',
			);
			const holdBadge = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-hold-badge]'),
				'[data-hold-badge]',
			);
			const questionSheet = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-question-sheet]'),
				'[data-question-sheet]',
			);
			const questionTerm = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-question-term]'),
				'[data-question-term]',
			);
			const answerGrid = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-answer-grid]'),
				'[data-answer-grid]',
			);
			const holdHint = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-hold-hint]'),
				'[data-hold-hint]',
			);
			const result = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-quiz-result]'),
				'[data-quiz-result]',
			);
			const resultTitle = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-result-title]'),
				'[data-result-title]',
			);
			const resultExplanation = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-result-explanation]'),
				'[data-result-explanation]',
			);
			const nextButton = requireQuizElement(
				quiz.querySelector<HTMLButtonElement>('[data-next-question]'),
				'[data-next-question]',
			);
			const finalScore = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-final-score]'),
				'[data-final-score]',
			);
			const finalScoreValue = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-final-score-value]'),
				'[data-final-score-value]',
			);
			const finalScoreMessage = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-final-score-message]'),
				'[data-final-score-message]',
			);
			const fireworks = requireQuizElement(
				quiz.querySelector<HTMLElement>('[data-fireworks]'),
				'[data-fireworks]',
			);

			const parsedQuestions: unknown = JSON.parse(questionData.textContent ?? '[]');

			if (
				!Array.isArray(parsedQuestions) ||
				parsedQuestions.length < GAME_LENGTH ||
				new Set(
					parsedQuestions
						.filter(isQuizQuestion)
						.map((question) => question.term.toLocaleLowerCase('de-AT')),
				).size !== parsedQuestions.length ||
				!parsedQuestions.every(isQuizQuestion)
			) {
				throw new Error('The football quiz data is invalid.');
			}

			const questions = parsedQuestions;
			let gameQuestions: GameQuestion[] = [];
			let currentRoundIndex = 0;
			let score = 0;
			let answered = false;
			let roundAnswers: Record<number, RoundAnswer> = {};
			let finished = false;
			let holdTimer: number | undefined;
			let releaseTimer: number | undefined;
			let heldButton: HTMLButtonElement | null = null;

			function saveProgress() {
				try {
					const payload: StoredProgress = {
						gameQuestions,
						currentRoundIndex,
						score,
						roundAnswers,
						finished,
					};

					window.localStorage.setItem(PROGRESS_STORAGE_KEY, JSON.stringify(payload));
				} catch {
					// Storage may be unavailable (private browsing, quota, disabled) - progress
					// simply won't persist, and the quiz keeps working in-memory as before.
				}
			}

			function loadProgress(): StoredProgress | null {
				try {
					const raw = window.localStorage.getItem(PROGRESS_STORAGE_KEY);
					if (!raw) return null;

					const parsed: unknown = JSON.parse(raw);

					if (typeof parsed !== 'object' || parsed === null) return null;

					const candidate = parsed as Partial<StoredProgress>;

					if (
						!Array.isArray(candidate.gameQuestions) ||
						candidate.gameQuestions.length !== GAME_LENGTH ||
						!candidate.gameQuestions.every(isGameQuestion)
					) {
						return null;
					}

					const restoredGameQuestions = candidate.gameQuestions;

					if (
						!Number.isInteger(candidate.currentRoundIndex) ||
						(candidate.currentRoundIndex as number) < 0 ||
						(candidate.currentRoundIndex as number) >= GAME_LENGTH
					) {
						return null;
					}

					const restoredCurrentRoundIndex = candidate.currentRoundIndex as number;

					if (typeof candidate.roundAnswers !== 'object' || candidate.roundAnswers === null) {
						return null;
					}

					const restoredRoundAnswers: Record<number, RoundAnswer> = {};

					for (const [key, value] of Object.entries(candidate.roundAnswers)) {
						const roundIndex = Number(key);

						if (
							!Number.isInteger(roundIndex) ||
							roundIndex < 0 ||
							roundIndex > restoredCurrentRoundIndex ||
							typeof value !== 'object' ||
							value === null
						) {
							return null;
						}

						const answer = value as Partial<RoundAnswer>;
						const question = restoredGameQuestions[roundIndex];

						if (
							!question ||
							!Number.isInteger(answer.selectedIndex) ||
							(answer.selectedIndex as number) < 0 ||
							(answer.selectedIndex as number) > 3
						) {
							return null;
						}

						restoredRoundAnswers[roundIndex] = {
							selectedIndex: answer.selectedIndex as number,
							isCorrect: answer.selectedIndex === question.correctIndex,
						};
					}

					const restoredScore = Object.values(restoredRoundAnswers).filter(
						(answer) => answer.isCorrect,
					).length;

					const restoredFinished =
						candidate.finished === true &&
						Array.from({ length: GAME_LENGTH }, (_value, index) => index).every(
							(index) => restoredRoundAnswers[index] !== undefined,
						);

					return {
						gameQuestions: restoredGameQuestions,
						currentRoundIndex: restoredCurrentRoundIndex,
						score: restoredScore,
						roundAnswers: restoredRoundAnswers,
						finished: restoredFinished,
					};
				} catch {
					return null;
				}
			}

			function cancelHold() {
				if (holdTimer !== undefined) {
					window.clearTimeout(holdTimer);
					holdTimer = undefined;
				}

				heldButton?.classList.remove('holding');
				heldButton = null;
			}

			function clearRelease(button: HTMLButtonElement) {
				if (releaseTimer !== undefined) {
					window.clearTimeout(releaseTimer);
					releaseTimer = undefined;
				}

				button.classList.remove('releasing');
				button.style.removeProperty('--fill-width');
			}

			function releaseHold() {
				const button = heldButton;

				if (!button || holdTimer === undefined || answered) {
					cancelHold();
					return;
				}

				const parsedWidth = Number.parseFloat(
					window.getComputedStyle(button, '::before').width,
				);
				const currentWidth = Number.isFinite(parsedWidth) ? parsedWidth : 0;
				// Even the fastest tap should visibly fill at least a third of the button, so
				// the hint is noticeable rather than a barely-visible sliver.
				const minFillWidth = button.offsetWidth / 3;
				const frozenWidth = Math.max(currentWidth, minFillWidth);

				cancelHold();
				clearRelease(button);

				button.style.setProperty('--fill-width', `${frozenWidth}px`);
				button.classList.add('releasing');

				// Force a reflow so the transition below animates from frozenWidth down to 0.
				void button.offsetWidth;

				button.style.setProperty('--fill-width', '0');

				releaseTimer = window.setTimeout(() => {
					releaseTimer = undefined;
					button.classList.remove('releasing');
					button.style.removeProperty('--fill-width');
				}, RELEASE_DURATION_MS);
			}

			function launchFireworks(sourceButton: HTMLButtonElement) {
				const quizRect = quiz.getBoundingClientRect();
				const buttonRect = sourceButton.getBoundingClientRect();
				const originX = buttonRect.left + buttonRect.width / 2 - quizRect.left;
				const originY = buttonRect.top + buttonRect.height / 2 - quizRect.top;
				const colors = ['#f7c948', '#c51d24', '#2f8550', '#ffffff'];
				const horizontalOffset = Math.min(quizRect.width * 0.2, 75);
				const bursts = [
					{ x: originX, y: originY, delay: 0 },
					{
						x: Math.max(45, originX - horizontalOffset),
						y: Math.max(70, originY - 70),
						delay: 320,
					},
					{
						x: Math.min(quizRect.width - 45, originX + horizontalOffset),
						y: Math.max(65, originY - 110),
						delay: 640,
					},
				];

				for (const [burstIndex, burst] of bursts.entries()) {
					for (let index = 0; index < 34; index += 1) {
						const particle = document.createElement('i');
						const angle = (Math.PI * 2 * index) / 34 + (burstIndex % 2) * 0.09;
						const distance = 72 + (index % 8) * 10;

						particle.className = 'quiz-firework-particle';
						particle.style.setProperty('--origin-x', `${burst.x}px`);
						particle.style.setProperty('--origin-y', `${burst.y}px`);
						particle.style.setProperty('--travel-x', `${Math.cos(angle) * distance}px`);
						particle.style.setProperty('--travel-y', `${Math.sin(angle) * distance}px`);
						particle.style.setProperty(
							'--particle-delay',
							`${burst.delay + (index % 5) * 24}ms`,
						);
						particle.style.setProperty(
							'--particle-color',
							colors[(index + burstIndex) % colors.length],
						);
						particle.addEventListener('animationend', () => particle.remove(), { once: true });
						fireworks.append(particle);
					}
				}
			}

			function recordAnswer(selectedIndex: number): { question: GameQuestion; isCorrect: boolean } | null {
				// Idempotent guard: a restored/replayed round or a duplicate lock attempt must
				// never re-score an already-answered round.
				if (answered) return null;

				const question = gameQuestions[currentRoundIndex];

				if (!Number.isInteger(selectedIndex) || !question) {
					throw new Error('The selected football quiz answer is invalid.');
				}

				answered = true;

				const isCorrect = selectedIndex === question.correctIndex;

				roundAnswers[currentRoundIndex] = { selectedIndex, isCorrect };

				if (isCorrect) {
					score += 1;
					scoreDisplay.textContent = String(score);
				}

				saveProgress();

				return { question, isCorrect };
			}

			function renderAnswerResult(
				button: HTMLButtonElement,
				question: GameQuestion,
				isCorrect: boolean,
				options: { launchCelebration: boolean },
			) {
				const answerButtons =
					answerGrid.querySelectorAll<HTMLButtonElement>('[data-answer-index]');
				const correctButton = answerButtons.item(question.correctIndex);

				for (const answerButton of answerButtons) {
					answerButton.setAttribute('aria-disabled', 'true');
				}

				button.classList.add(isCorrect ? 'correct' : 'wrong');

				if (!isCorrect) {
					correctButton?.classList.add('correct-answer');
				}

				result.classList.toggle('correct-result', isCorrect);
				result.classList.toggle('wrong-result', !isCorrect);
				resultTitle.textContent = isCorrect ? 'Richtig!' : 'Noch nicht ganz.';
				resultExplanation.textContent = isCorrect
					? question.explanation
					: `Richtig wäre: „${question.answers[question.correctIndex]}“ ${question.explanation}`;
				result.hidden = false;
				holdHint.hidden = true;
				nextButton.hidden = false;
				nextButton.textContent =
					currentRoundIndex === GAME_LENGTH - 1 ? 'Ergebnis ansehen →' : 'Nächste Frage →';

				if (isCorrect && options.launchCelebration) {
					launchFireworks(button);
				}
			}

			function lockAnswer(button: HTMLButtonElement) {
				cancelHold();

				const selectedIndex = Number(button.dataset.answerIndex);
				const recorded = recordAnswer(selectedIndex);

				if (!recorded) return;

				renderAnswerResult(button, recorded.question, recorded.isCorrect, {
					launchCelebration: true,
				});
			}

			function restoreAnsweredRound(roundIndex: number) {
				const storedAnswer = roundAnswers[roundIndex];
				const question = gameQuestions[roundIndex];

				if (!storedAnswer || !question) return;

				renderQuestion(roundIndex);
				// renderQuestion() resets `answered` to false as part of a fresh round - reapply
				// it here since this round was already answered before the page was reloaded.
				answered = true;

				const button = answerGrid.querySelector<HTMLButtonElement>(
					`[data-answer-index="${storedAnswer.selectedIndex}"]`,
				);

				if (button) {
					renderAnswerResult(button, question, storedAnswer.isCorrect, {
						launchCelebration: false,
					});
				}
			}

			function startHold(button: HTMLButtonElement) {
				if (answered || button.disabled) return;

				cancelHold();
				clearRelease(button);
				heldButton = button;
				button.classList.add('holding');
				holdTimer = window.setTimeout(() => lockAnswer(button), HOLD_DURATION_MS);
			}

			function connectAnswerButton(button: HTMLButtonElement) {
				button.addEventListener('pointerdown', (event) => {
					if (!event.isPrimary || (event.pointerType === 'mouse' && event.button !== 0)) return;

					event.preventDefault();
					button.setPointerCapture(event.pointerId);
					startHold(button);
				});
				button.addEventListener('pointerup', releaseHold);
				button.addEventListener('pointercancel', releaseHold);
				button.addEventListener('lostpointercapture', releaseHold);
				button.addEventListener('contextmenu', (event) => event.preventDefault());
				button.addEventListener('click', (event) => event.preventDefault());
				button.addEventListener('keydown', (event) => {
					if ((event.key === ' ' || event.key === 'Enter') && !event.repeat) {
						event.preventDefault();
						startHold(button);
					}
				});
				button.addEventListener('keyup', (event) => {
					if (event.key === ' ' || event.key === 'Enter') {
						event.preventDefault();
						releaseHold();
					}
				});
				button.addEventListener('blur', releaseHold);
			}

			function createAnswerButton(answer: string, index: number) {
				const button = document.createElement('button');
				const letter = document.createElement('span');
				const answerText = document.createElement('span');

				button.type = 'button';
				button.className = 'answer-button';
				button.dataset.answerIndex = String(index);
				button.setAttribute(
					'aria-label',
					`${ANSWER_LETTERS[index]}: ${answer}. Gedrückt halten, um diese Antwort auszuwählen.`,
				);
				letter.className = 'answer-letter';
				letter.setAttribute('aria-hidden', 'true');
				letter.textContent = ANSWER_LETTERS[index];
				answerText.className = 'answer-text';
				answerText.textContent = answer;
				button.append(letter, answerText);
				connectAnswerButton(button);

				return button;
			}

			function renderQuestion(roundIndex: number) {
				const question = gameQuestions[roundIndex];

				if (!question) {
					throw new Error('The requested football quiz question does not exist.');
				}

				cancelHold();
				answered = false;
				currentRoundIndex = roundIndex;
				questionCount.textContent = `Frage ${roundIndex + 1} von ${GAME_LENGTH}`;
				questionTerm.textContent = question.term;
				questionSheet.hidden = false;
				answerGrid.hidden = false;
				answerGrid.replaceChildren(
					...question.answers.map((answer, answerIndex) =>
						createAnswerButton(answer, answerIndex),
					),
				);
				result.hidden = true;
				result.classList.remove('correct-result', 'wrong-result');
				resultTitle.textContent = '';
				resultExplanation.textContent = '';
				holdHint.hidden = false;
				nextButton.hidden = true;
				holdBadge.hidden = false;
				finalScore.hidden = true;
				fireworks.replaceChildren();
				saveProgress();
			}

			function showFinalScore() {
				cancelHold();
				finished = true;
				questionCount.textContent = 'Spiel beendet';
				questionSheet.hidden = true;
				answerGrid.hidden = true;
				holdHint.hidden = true;
				holdBadge.hidden = true;
				result.hidden = true;
				finalScoreValue.textContent = String(score);
				finalScoreMessage.textContent =
					score === GAME_LENGTH
						? 'Perfektes Spiel – alle Begriffe sitzen!'
						: score >= 9
							? 'Starke Leistung – du kennst den Fußball-Code!'
							: score >= 6
								? 'Gut gespielt – mit etwas Übung wird es noch besser.'
								: 'Dranbleiben – beim nächsten Spiel holst du mehr Punkte.';
				finalScore.hidden = false;
				nextButton.textContent = 'Neues Spiel starten ↻';
				nextButton.hidden = false;
				saveProgress();
			}

			function startNewGame() {
				gameQuestions = createGame(questions);
				score = 0;
				scoreDisplay.textContent = '0';
				roundAnswers = {};
				finished = false;
				renderQuestion(0);
			}

			nextButton.addEventListener('click', () => {
				if (!finalScore.hidden) {
					startNewGame();
				} else if (currentRoundIndex === GAME_LENGTH - 1) {
					showFinalScore();
				} else {
					renderQuestion(currentRoundIndex + 1);
				}

				quiz.scrollIntoView({
					behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
						? 'auto'
						: 'smooth',
					block: 'start',
				});
			});

			const restoredProgress = loadProgress();

			if (restoredProgress) {
				gameQuestions = restoredProgress.gameQuestions;
				currentRoundIndex = restoredProgress.currentRoundIndex;
				score = restoredProgress.score;
				roundAnswers = restoredProgress.roundAnswers;
				finished = restoredProgress.finished;
				scoreDisplay.textContent = String(score);

				if (finished) {
					showFinalScore();
				} else if (roundAnswers[currentRoundIndex]) {
					restoreAnsweredRound(currentRoundIndex);
				} else {
					renderQuestion(currentRoundIndex);
				}
			} else {
				startNewGame();
			}
		}
	}

	initializeFootballQuizzes();
	document.addEventListener('astro:page-load', initializeFootballQuizzes);
</script>

