---
const positions = [
	{
		id: 'striker',
		short: 'ST',
		pitchLabel: 'Sturm',
		label: 'Sturm',
		possession: { x: 50, y: 23 },
		defending: { x: 50, y: 43 },
		heatmap: [
			{ x: 50, y: 21, width: 62, height: 38, rotate: 0 },
		],
		responsibility:
			'Du bist die vorderste Anspielstation, beschäftigst die gegnerische Abwehr und startest unser Pressing.',
		offense:
			'Bleib zunächst hoch und zentral. Laufe in freie Räume hinter der Abwehr oder komm dem Ball kurz entgegen. Vor dem Tor ziehst du entschlossen zum Abschluss.',
		defense:
			'Falle in unsere erste Dreierlinie zurück und ordne dich zwischen LF und RF ein. Gemeinsam schließt ihr zentrale Passwege und lenkt den Spielaufbau auf eine Seite.',
	},
	{
		id: 'left-midfield',
		short: 'LF',
		pitchLabel: 'Linker Flügel',
		label: 'Linker Flügel',
		possession: { x: 12, y: 34 },
		defending: { x: 25, y: 43 },
		heatmap: [
			{ x: 24, y: 30, width: 52, height: 60, rotate: 0 },
		],
		responsibility:
			'Du gibst unserem Spiel auf der linken Seite Breite, unterstützt Angriff und Verteidigung und suchst mutig das Eins-gegen-eins.',
		offense:
			'Geh auf der linken Seite in die Tiefe und so breit wie möglich bis an die Seitenlinie. Ist der Ball rechts, rücke Richtung zweiter Pfosten ein.',
		defense:
			'Laufe in die erste Dreierlinie zurück und bleib links neben ST. Schließe den Weg nach außen; ist der Ball rechts, rücke mit der ganzen Linie zur Mitte.',
	},
	{
		id: 'center-midfield',
		short: 'ZM',
		pitchLabel: 'Zentrales Mittelfeld',
		label: 'Zentrales Mittelfeld',
		possession: { x: 50, y: 56 },
		defending: { x: 50, y: 62 },
		heatmap: [
			{ x: 50, y: 51, width: 66, height: 52, rotate: 0 },
		],
		responsibility:
			'Du verbindest Abwehr und Angriff, orientierst dich vor jeder Ballannahme und hilfst deinen Mitspielern durch klare Kommandos.',
		offense:
			'Zeig dich im Zentrum in einem freien Passfenster und spiele möglichst nach vorne. Unterstütze immer hinter oder neben dem Ball und stoße bei Platz in den Strafraum nach.',
		defense:
			'Falle zwischen LV und RV in die letzte Dreierlinie zurück. Sichere dort die Mitte, bleib zwischen Ball und eigenem Tor und verschiebe gemeinsam zur Ballseite.',
	},
	{
		id: 'right-midfield',
		short: 'RF',
		pitchLabel: 'Rechter Flügel',
		label: 'Rechter Flügel',
		possession: { x: 88, y: 34 },
		defending: { x: 75, y: 43 },
		heatmap: [
			{ x: 76, y: 30, width: 52, height: 60, rotate: 0 },
		],
		responsibility:
			'Du gibst unserem Spiel auf der rechten Seite Breite, unterstützt Angriff und Verteidigung und suchst mutig das Eins-gegen-eins.',
		offense:
			'Geh auf der rechten Seite in die Tiefe und so breit wie möglich bis an die Seitenlinie. Ist der Ball links, rücke Richtung zweiter Pfosten ein.',
		defense:
			'Laufe in die erste Dreierlinie zurück und bleib rechts neben ST. Schließe den Weg nach außen; ist der Ball links, rücke mit der ganzen Linie zur Mitte.',
	},
	{
		id: 'left-defense',
		short: 'LV',
		pitchLabel: 'Linker Verteidiger',
		label: 'Linker Verteidiger',
		possession: { x: 15, y: 70 },
		defending: { x: 31, y: 62 },
		heatmap: [
			{ x: 17, y: 47, width: 40, height: 94, rotate: 0 },
		],
		responsibility:
			'Du sicherst unsere linke Seite, verteidigst zuerst den Weg zum Tor und eröffnest aus der Abwehr unser Spiel.',
		offense:
			'Geh im Spielaufbau weit nach links außen und mach das Feld breit. Bei freiem Raum starte entlang der Seitenlinie bis zur gegnerischen Grundlinie.',
		defense:
			'Laufe schnell Richtung eigenes Tor und stelle dich zwischen Gegner und Tor. Ballnah gehst du zum Gegner, ballfern rückst du eng zu deinem Abwehrpartner.',
	},
	{
		id: 'right-defense',
		short: 'RV',
		pitchLabel: 'Rechter Verteidiger',
		label: 'Rechter Verteidiger',
		possession: { x: 85, y: 70 },
		defending: { x: 69, y: 62 },
		heatmap: [
			{ x: 83, y: 47, width: 40, height: 94, rotate: 0 },
		],
		responsibility:
			'Du sicherst unsere rechte Seite, verteidigst zuerst den Weg zum Tor und eröffnest aus der Abwehr unser Spiel.',
		offense:
			'Geh im Spielaufbau weit nach rechts außen und mach das Feld breit. Bei freiem Raum starte entlang der Seitenlinie bis zur gegnerischen Grundlinie.',
		defense:
			'Laufe schnell Richtung eigenes Tor und stelle dich zwischen Gegner und Tor. Ballnah gehst du zum Gegner, ballfern rückst du eng zu deinem Abwehrpartner.',
	},
	{
		id: 'goalkeeper',
		short: 'TW',
		pitchLabel: 'Tor',
		label: 'Torwart',
		possession: { x: 50, y: 87 },
		defending: { x: 50, y: 82 },
		heatmap: [
			{ x: 50, y: 84, width: 58, height: 34, rotate: 0 },
		],
		responsibility:
			'Du schützt das Tor, ordnest laut die Abwehr und bist als zusätzliche Anspielstation Teil unseres Spielaufbaus.',
		offense:
			'Rücke hinter der Abwehr nach und bleib anspielbar. Eröffne möglichst kontrolliert und flach; nach deinem Pass verschiebst du mit dem Team.',
		defense:
			'Steh zentral zum Ball und passe deinen Abstand zum Tor an. Bei Pässen in die Tiefe kommst du mutig heraus, bei Schüssen sicherst du zuerst das Tor.',
	},
];

const phases = [
	{
		id: 'possession',
		label: 'Ballbesitz',
		description: 'Wir haben den Ball',
		explanation: 'LF und RF besetzen beide Seitenlinien und starten in die Tiefe; LV und RV schieben breit nach.',
	},
	{
		id: 'defending',
		label: 'Gegen den Ball',
		description: 'Gegner hat den Ball',
		explanation: 'Wir verteidigen im Mittelfeld: ST zwischen LF und RF, ZM zwischen LV und RV – kompakt, aber nicht zu tief.',
	},
];

const activePosition = positions.find((position) => position.id === 'center-midfield') ?? positions[0];
const activePhase = phases[0];
---

<section class="formation-board" data-formation-board data-mode={activePhase.id}>
	<div class="phase-selector" role="group" aria-label="Spielphase auswählen">
		{phases.map((phase) => (
			<button
				type="button"
				class:list={['phase-button', { active: phase.id === activePhase.id }]}
				data-formation-mode={phase.id}
				data-explanation={phase.explanation}
				aria-pressed={phase.id === activePhase.id ? 'true' : 'false'}
			>
				<strong>{phase.label}</strong>
				<small>{phase.description}</small>
			</button>
		))}
	</div>

	<p class="phase-explanation" data-phase-explanation>{activePhase.explanation}</p>

	<div class="board-heading">
		<p>Angriffsrichtung <span aria-hidden="true">↑</span></p>
		<strong>Tippe auf eine Position</strong>
	</div>

	<div class="pitch" aria-label="1-2-3-1-Aufstellung, unser Tor ist unten">
		<span class="goal opponent-goal" aria-hidden="true"></span>
		<span class="goal own-goal" aria-hidden="true"></span>
		<span class="halfway-line" aria-hidden="true"></span>
		<span class="center-circle" aria-hidden="true"></span>
		<span class="penalty-area opponent-area" aria-hidden="true"></span>
		<span class="penalty-area own-area" aria-hidden="true"></span>

		<div class="heatmap" aria-hidden="true">
			{positions.map((position) => (
				<div class="heatmap-zone" data-heatmap-for={position.id}>
					{position.heatmap.map((spot) => (
						<span
							style={`--heat-x: ${spot.x}%; --heat-y: ${spot.y}%; --heat-width: ${spot.width}%; --heat-height: ${spot.height}%; --heat-rotate: ${spot.rotate}deg`}
						></span>
					))}
				</div>
			))}
		</div>
		<div class="heatmap-key" aria-hidden="true">
			<span></span>
			Typischer Aktionsraum
		</div>

		{positions.map((position) => (
			<button
				type="button"
				class:list={['player-position', { active: position.id === activePosition.id }]}
				style={`--x: ${position.possession.x}%; --y: ${position.possession.y}%`}
				data-position={position.id}
				data-label={position.label}
				data-responsibility={position.responsibility}
				data-offense={position.offense}
				data-defense={position.defense}
				data-possession-x={position.possession.x}
				data-possession-y={position.possession.y}
				data-defending-x={position.defending.x}
				data-defending-y={position.defending.y}
				aria-label={`${position.label} auswählen`}
				aria-controls="position-details"
				aria-pressed={position.id === activePosition.id ? 'true' : 'false'}
			>
				<span>{position.short}</span>
				<small>{position.pitchLabel}</small>
			</button>
		))}
	</div>

	<section class="position-details" id="position-details" aria-live="polite" aria-atomic="true">
		<p class="details-eyebrow">Gewählte Position</p>
		<h2 data-position-label>{activePosition.label}</h2>
		<div class="detail-block responsibility">
			<h3>Deine Aufgabe</h3>
			<p data-position-responsibility>{activePosition.responsibility}</p>
		</div>
		<div class="detail-block offense">
			<h3><span aria-hidden="true">↑</span> Mit dem Ball</h3>
			<p data-position-offense>{activePosition.offense}</p>
		</div>
		<div class="detail-block defense">
			<h3><span aria-hidden="true">↓</span> Gegen den Ball</h3>
			<p data-position-defense>{activePosition.defense}</p>
		</div>
	</section>

	<p class="team-rule">
		<strong>Unser Merksatz:</strong> Mit dem Ball machen wir das Feld groß. Gegen den Ball machen wir es
		klein.
	</p>
</section>

<script>
	function initializeFormationBoards() {
		const boards = document.querySelectorAll<HTMLElement>('[data-formation-board]');

		for (const board of boards) {
			if (board.dataset.initialized === 'true') continue;
			board.dataset.initialized = 'true';

			const positionButtons = board.querySelectorAll<HTMLButtonElement>('[data-position]');
			const phaseButtons = board.querySelectorAll<HTMLButtonElement>('[data-formation-mode]');
			const heatmapZones = board.querySelectorAll<HTMLElement>('[data-heatmap-for]');
			const phaseExplanation = board.querySelector<HTMLElement>('[data-phase-explanation]');
			const label = board.querySelector<HTMLElement>('[data-position-label]');
			const responsibility = board.querySelector<HTMLElement>('[data-position-responsibility]');
			const offense = board.querySelector<HTMLElement>('[data-position-offense]');
			const defense = board.querySelector<HTMLElement>('[data-position-defense]');

			for (const phaseButton of phaseButtons) {
				phaseButton.addEventListener('click', () => {
					const mode = phaseButton.dataset.formationMode;
					if (mode !== 'possession' && mode !== 'defending') return;

					board.dataset.mode = mode;
					board.dataset.heatmapVisible = 'false';

					for (const otherPhaseButton of phaseButtons) {
						const isActive = otherPhaseButton === phaseButton;
						otherPhaseButton.classList.toggle('active', isActive);
						otherPhaseButton.setAttribute('aria-pressed', String(isActive));
					}

					for (const positionButton of positionButtons) {
						const x =
							mode === 'possession'
								? positionButton.dataset.possessionX
								: positionButton.dataset.defendingX;
						const y =
							mode === 'possession'
								? positionButton.dataset.possessionY
								: positionButton.dataset.defendingY;

						if (x) positionButton.style.setProperty('--x', `${x}%`);
						if (y) positionButton.style.setProperty('--y', `${y}%`);
					}

					if (phaseExplanation) {
						phaseExplanation.textContent = phaseButton.dataset.explanation ?? '';
					}
				});
			}

			for (const button of positionButtons) {
				button.addEventListener('click', () => {
					for (const otherButton of positionButtons) {
						const isActive = otherButton === button;
						otherButton.classList.toggle('active', isActive);
						otherButton.setAttribute('aria-pressed', String(isActive));
					}

					const showHeatmap = board.dataset.mode === 'possession';
					board.dataset.heatmapVisible = String(showHeatmap);

					for (const zone of heatmapZones) {
						zone.classList.toggle(
							'active',
							showHeatmap && zone.dataset.heatmapFor === button.dataset.position,
						);
					}

					if (label) label.textContent = button.dataset.label ?? '';
					if (responsibility) responsibility.textContent = button.dataset.responsibility ?? '';
					if (offense) offense.textContent = button.dataset.offense ?? '';
					if (defense) defense.textContent = button.dataset.defense ?? '';
				});
			}
		}
	}

	initializeFormationBoards();
	document.addEventListener('astro:page-load', initializeFormationBoards);
</script>

<style>
	.formation-board {
		display: grid;
		gap: 0.9rem;
		min-width: 0;
	}

	.phase-selector {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem;
		padding: 0.35rem;
		border: 1px solid rgb(255 255 255 / 20%);
		border-radius: 0.65rem;
		background: rgb(15 15 15 / 72%);
		box-shadow: var(--shadow);
	}

	.phase-button {
		display: grid;
		min-width: 0;
		min-height: 3.75rem;
		padding: 0.65rem 0.55rem;
		place-content: center;
		border: 1px solid rgb(255 255 255 / 18%);
		border-radius: 0.45rem;
		color: rgb(255 255 255 / 72%);
		background: rgb(255 255 255 / 7%);
		text-align: center;
		cursor: pointer;
		transition:
			color 150ms ease,
			background 150ms ease,
			transform 150ms ease;
	}

	.phase-button strong,
	.phase-button small {
		display: block;
	}

	.phase-button strong {
		font-size: 0.83rem;
		line-height: 1.2;
	}

	.phase-button small {
		margin-top: 0.15rem;
		font-size: 0.66rem;
		line-height: 1.25;
	}

	.phase-button.active {
		border-color: #ff777b;
		color: white;
		background: var(--accent);
		box-shadow: 0 0.25rem 0.7rem rgb(0 0 0 / 28%);
		transform: translateY(-0.08rem);
	}

	.phase-explanation {
		padding: 0.65rem 0.8rem;
		margin: -0.35rem 0 0;
		border-left: 0.25rem solid var(--accent);
		color: rgb(255 255 255 / 78%);
		background: rgb(15 15 15 / 52%);
		font-size: 0.78rem;
		line-height: 1.4;
	}

	.board-heading {
		display: flex;
		padding: 0.7rem 0.85rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-radius: 0.4rem;
		color: white;
		background: var(--black);
		box-shadow: var(--shadow);
	}

	.board-heading p,
	.board-heading strong {
		margin: 0;
		font-size: 0.74rem;
	}

	.board-heading p {
		color: #bde4c8;
		font-weight: 900;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.board-heading p span {
		font-size: 1rem;
	}

	.board-heading strong {
		text-align: right;
	}

	.pitch {
		position: relative;
		width: 100%;
		height: min(112vw, 31rem);
		min-height: 24rem;
		border: 0.35rem solid #e8f3e9;
		border-radius: 0.35rem;
		background:
			repeating-linear-gradient(
				0deg,
				rgb(255 255 255 / 4%) 0,
				rgb(255 255 255 / 4%) 12.5%,
				rgb(0 0 0 / 4%) 12.5%,
				rgb(0 0 0 / 4%) 25%
			),
			#347448;
		box-shadow:
			inset 0 0 0 0.2rem rgb(255 255 255 / 35%),
			var(--shadow);
		overflow: hidden;
	}

	.halfway-line {
		position: absolute;
		top: 50%;
		right: 0;
		left: 0;
		border-top: 2px solid rgb(255 255 255 / 70%);
	}

	.center-circle {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 5rem;
		height: 5rem;
		border: 2px solid rgb(255 255 255 / 70%);
		border-radius: 50%;
		transform: translate(-50%, -50%);
	}

	.center-circle::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 50%;
		background: rgb(255 255 255 / 75%);
		transform: translate(-50%, -50%);
	}

	.penalty-area {
		position: absolute;
		left: 50%;
		width: 55%;
		height: 17%;
		border: 2px solid rgb(255 255 255 / 70%);
		transform: translateX(-50%);
	}

	.opponent-area {
		top: -2px;
	}

	.own-area {
		bottom: -2px;
	}

	.goal {
		position: absolute;
		z-index: 2;
		left: 50%;
		width: 28%;
		height: 2.5%;
		border: 2px solid rgb(255 255 255 / 82%);
		transform: translateX(-50%);
	}

	.opponent-goal {
		top: -2px;
		border-top: 0;
	}

	.own-goal {
		bottom: -2px;
		border-bottom: 0;
	}

	.halfway-line,
	.center-circle,
	.penalty-area {
		z-index: 2;
	}

	.heatmap {
		position: absolute;
		z-index: 1;
		inset: 0;
		pointer-events: none;
	}

	.heatmap-zone {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 220ms ease;
	}

	.heatmap-zone span {
		position: absolute;
		top: var(--heat-y);
		left: var(--heat-x);
		width: var(--heat-width);
		height: var(--heat-height);
		filter: blur(0.55rem);
		transform: translate(-50%, -50%) rotate(var(--heat-rotate));
	}

	.heatmap-zone span::before {
		content: "";
		position: absolute;
		inset: 0;
		background:
			radial-gradient(circle at 37% 42%, rgb(218 24 31 / 82%) 0 10%, rgb(255 126 0 / 60%) 24%, transparent 48%),
			radial-gradient(circle at 66% 58%, rgb(218 24 31 / 68%) 0 8%, rgb(255 156 0 / 52%) 26%, transparent 50%),
			linear-gradient(135deg, rgb(255 238 97 / 18%), rgb(255 176 20 / 36%) 48%, rgb(255 238 97 / 15%));
		clip-path: polygon(
			8% 14%,
			28% 3%,
			47% 10%,
			68% 0,
			92% 16%,
			84% 34%,
			100% 52%,
			86% 69%,
			94% 88%,
			67% 96%,
			48% 88%,
			24% 100%,
			9% 82%,
			16% 63%,
			0 45%,
			15% 29%
		);
	}

	.heatmap-zone[data-heatmap-for="left-midfield"] span::before {
		background:
			radial-gradient(circle at 18% 64%, rgb(218 24 31 / 78%) 0 8%, rgb(255 126 0 / 56%) 23%, transparent 45%),
			radial-gradient(circle at 39% 18%, rgb(218 24 31 / 75%) 0 8%, rgb(255 142 0 / 56%) 23%, transparent 46%),
			radial-gradient(circle at 78% 16%, rgb(218 24 31 / 62%) 0 7%, rgb(255 174 0 / 48%) 22%, transparent 43%),
			linear-gradient(105deg, rgb(255 238 97 / 17%), rgb(255 176 20 / 34%) 52%, rgb(255 238 97 / 14%));
		clip-path: polygon(0 2%, 100% 0, 96% 31%, 42% 37%, 37% 100%, 2% 96%, 6% 58%);
	}

	.heatmap-zone[data-heatmap-for="right-midfield"] span::before {
		background:
			radial-gradient(circle at 82% 64%, rgb(218 24 31 / 78%) 0 8%, rgb(255 126 0 / 56%) 23%, transparent 45%),
			radial-gradient(circle at 61% 18%, rgb(218 24 31 / 75%) 0 8%, rgb(255 142 0 / 56%) 23%, transparent 46%),
			radial-gradient(circle at 22% 16%, rgb(218 24 31 / 62%) 0 7%, rgb(255 174 0 / 48%) 22%, transparent 43%),
			linear-gradient(255deg, rgb(255 238 97 / 17%), rgb(255 176 20 / 34%) 52%, rgb(255 238 97 / 14%));
		clip-path: polygon(0 0, 100% 2%, 94% 58%, 98% 96%, 63% 100%, 58% 37%, 4% 31%);
	}

	.heatmap-zone[data-heatmap-for="left-defense"] span::before {
		background:
			radial-gradient(circle at 34% 72%, rgb(218 24 31 / 78%) 0 9%, rgb(255 126 0 / 58%) 25%, transparent 50%),
			radial-gradient(circle at 15% 28%, rgb(218 24 31 / 65%) 0 7%, rgb(255 161 0 / 48%) 24%, transparent 46%),
			linear-gradient(120deg, rgb(255 238 97 / 16%), rgb(255 176 20 / 35%) 58%, rgb(255 238 97 / 15%));
		clip-path: polygon(3% 0, 38% 2%, 42% 45%, 100% 54%, 92% 100%, 8% 96%, 0 52%);
	}

	.heatmap-zone[data-heatmap-for="right-defense"] span::before {
		background:
			radial-gradient(circle at 66% 72%, rgb(218 24 31 / 78%) 0 9%, rgb(255 126 0 / 58%) 25%, transparent 50%),
			radial-gradient(circle at 85% 28%, rgb(218 24 31 / 65%) 0 7%, rgb(255 161 0 / 48%) 24%, transparent 46%),
			linear-gradient(240deg, rgb(255 238 97 / 16%), rgb(255 176 20 / 35%) 58%, rgb(255 238 97 / 15%));
		clip-path: polygon(62% 2%, 97% 0, 100% 52%, 92% 96%, 8% 100%, 0 54%, 58% 45%);
	}

	.heatmap-zone[data-heatmap-for="striker"] span::before,
	.heatmap-zone[data-heatmap-for="center-midfield"] span::before,
	.heatmap-zone[data-heatmap-for="goalkeeper"] span::before {
		background:
			radial-gradient(circle at 50% 42%, rgb(218 24 31 / 82%) 0 11%, rgb(255 126 0 / 58%) 25%, transparent 48%),
			radial-gradient(circle at 28% 60%, rgb(218 24 31 / 56%) 0 7%, rgb(255 166 0 / 44%) 24%, transparent 46%),
			radial-gradient(circle at 72% 60%, rgb(218 24 31 / 56%) 0 7%, rgb(255 166 0 / 44%) 24%, transparent 46%),
			linear-gradient(90deg, rgb(255 238 97 / 15%), rgb(255 176 20 / 36%) 50%, rgb(255 238 97 / 15%));
		clip-path: polygon(
			50% 0,
			76% 6%,
			92% 20%,
			100% 50%,
			92% 80%,
			76% 94%,
			50% 100%,
			24% 94%,
			8% 80%,
			0 50%,
			8% 20%,
			24% 6%
		);
	}

	.formation-board[data-mode="possession"][data-heatmap-visible="true"] .heatmap-zone.active {
		opacity: 1;
	}

	.heatmap-key {
		position: absolute;
		z-index: 4;
		top: 0.55rem;
