---
const positions = [
	{
		id: 'striker',
		short: 'ST',
		pitchLabel: 'Sturm',
		label: 'Stürmer/in',
		x: 50,
		y: 12,
		responsibility:
			'Du bist die vorderste Anspielstation, beschäftigst die gegnerische Abwehr und startest unser Pressing.',
		offense:
			'Bleib zunächst hoch und zentral. Laufe in freie Räume hinter der Abwehr oder komm dem Ball kurz entgegen. Vor dem Tor ziehst du entschlossen zum Abschluss.',
		defense:
			'Lenke den Spielaufbau des Gegners auf eine Seite und setze den ersten Verteidiger unter Druck. Rücke bis vor unser Mittelfeld zurück, ohne die Tiefe nach vorne aufzugeben.',
	},
	{
		id: 'left-midfield',
		short: 'LM',
		pitchLabel: 'Links',
		label: 'Linkes Mittelfeld',
		x: 18,
		y: 39,
		responsibility:
			'Du gibst unserem Spiel auf der linken Seite Breite, unterstützt Angriff und Verteidigung und suchst mutig das Eins-gegen-eins.',
		offense:
			'Mach das Feld links breit und schiebe nach vorne. Ist der Ball rechts, rücke Richtung zweiter Pfosten ein. Biete dich nach Pässen sofort wieder an.',
		defense:
			'Laufe auf der linken Seite zurück und unterstütze die Abwehr. Schließe den Weg nach außen; ist der Ball auf der anderen Seite, rücke zur Mitte.',
	},
	{
		id: 'center-midfield',
		short: 'ZM',
		pitchLabel: 'Zentrum',
		label: 'Zentrales Mittelfeld',
		x: 50,
		y: 39,
		responsibility:
			'Du verbindest Abwehr und Angriff, orientierst dich vor jeder Ballannahme und hilfst deinen Mitspielern durch klare Kommandos.',
		offense:
			'Zeig dich im Zentrum in einem freien Passfenster und spiele möglichst nach vorne. Unterstütze immer hinter oder neben dem Ball und stoße bei Platz in den Strafraum nach.',
		defense:
			'Sichere die Mitte und verschiebe zur Ballseite. Bleib zwischen Ball und eigenem Tor, nimm zentrale Gegenspieler auf und unterstütze dort, wo Überzahl gebraucht wird.',
	},
	{
		id: 'right-midfield',
		short: 'RM',
		pitchLabel: 'Rechts',
		label: 'Rechtes Mittelfeld',
		x: 82,
		y: 39,
		responsibility:
			'Du gibst unserem Spiel auf der rechten Seite Breite, unterstützt Angriff und Verteidigung und suchst mutig das Eins-gegen-eins.',
		offense:
			'Mach das Feld rechts breit und schiebe nach vorne. Ist der Ball links, rücke Richtung zweiter Pfosten ein. Biete dich nach Pässen sofort wieder an.',
		defense:
			'Laufe auf der rechten Seite zurück und unterstütze die Abwehr. Schließe den Weg nach außen; ist der Ball auf der anderen Seite, rücke zur Mitte.',
	},
	{
		id: 'left-defense',
		short: 'LV',
		pitchLabel: 'Abwehr L',
		label: 'Linke Verteidigung',
		x: 30,
		y: 67,
		responsibility:
			'Du sicherst unsere linke Seite, verteidigst zuerst den Weg zum Tor und eröffnest gemeinsam mit dem Torhüter unser Spiel.',
		offense:
			'Schiebe links bis etwa auf Höhe des Mittelfelds nach und bleib anspielbar. Ist der Ball rechts, rücke hinter dem Ball zur Mitte und sichere ab.',
		defense:
			'Laufe schnell Richtung eigenes Tor und stelle dich zwischen Gegner und Tor. Ballnah gehst du zum Gegner, ballfern rückst du eng zu deinem Abwehrpartner.',
	},
	{
		id: 'right-defense',
		short: 'RV',
		pitchLabel: 'Abwehr R',
		label: 'Rechte Verteidigung',
		x: 70,
		y: 67,
		responsibility:
			'Du sicherst unsere rechte Seite, verteidigst zuerst den Weg zum Tor und eröffnest gemeinsam mit dem Torhüter unser Spiel.',
		offense:
			'Schiebe rechts bis etwa auf Höhe des Mittelfelds nach und bleib anspielbar. Ist der Ball links, rücke hinter dem Ball zur Mitte und sichere ab.',
		defense:
			'Laufe schnell Richtung eigenes Tor und stelle dich zwischen Gegner und Tor. Ballnah gehst du zum Gegner, ballfern rückst du eng zu deinem Abwehrpartner.',
	},
	{
		id: 'goalkeeper',
		short: 'TW',
		pitchLabel: 'Tor',
		label: 'Torhüter/in',
		x: 50,
		y: 88,
		responsibility:
			'Du schützt das Tor, ordnest laut die Abwehr und bist als zusätzliche Anspielstation Teil unseres Spielaufbaus.',
		offense:
			'Rücke hinter der Abwehr nach und bleib anspielbar. Eröffne möglichst kontrolliert und flach; nach deinem Pass verschiebst du mit dem Team.',
		defense:
			'Steh zentral zum Ball und passe deinen Abstand zum Tor an. Bei Pässen in die Tiefe kommst du mutig heraus, bei Schüssen sicherst du zuerst das Tor.',
	},
];

const activePosition = positions.find((position) => position.id === 'center-midfield') ?? positions[0];
---

<section class="formation-board" data-formation-board>
	<div class="board-heading">
		<p>Angriffsrichtung <span aria-hidden="true">↑</span></p>
		<strong>Tippe auf einen Spieler</strong>
	</div>

	<div class="pitch" aria-label="1-2-3-1-Aufstellung, unser Tor ist unten">
		<span class="goal opponent-goal" aria-hidden="true"></span>
		<span class="goal own-goal" aria-hidden="true"></span>
		<span class="halfway-line" aria-hidden="true"></span>
		<span class="center-circle" aria-hidden="true"></span>
		<span class="penalty-area opponent-area" aria-hidden="true"></span>
		<span class="penalty-area own-area" aria-hidden="true"></span>

		{positions.map((position) => (
			<button
				type="button"
				class:list={['player-position', { active: position.id === activePosition.id }]}
				style={`--x: ${position.x}%; --y: ${position.y}%`}
				data-position={position.id}
				data-label={position.label}
				data-responsibility={position.responsibility}
				data-offense={position.offense}
				data-defense={position.defense}
				aria-label={`${position.label} auswählen`}
				aria-controls="position-details"
				aria-pressed={position.id === activePosition.id ? 'true' : 'false'}
			>
				<span>{position.short}</span>
				<small>{position.pitchLabel}</small>
			</button>
		))}
	</div>

	<section class="position-details" id="position-details" aria-live="polite" aria-atomic="true">
		<p class="details-eyebrow">Gewählte Position</p>
		<h2 data-position-label>{activePosition.label}</h2>
		<div class="detail-block responsibility">
			<h3>Deine Aufgabe</h3>
			<p data-position-responsibility>{activePosition.responsibility}</p>
		</div>
		<div class="detail-block offense">
			<h3><span aria-hidden="true">↑</span> Mit dem Ball</h3>
			<p data-position-offense>{activePosition.offense}</p>
		</div>
		<div class="detail-block defense">
			<h3><span aria-hidden="true">↓</span> Gegen den Ball</h3>
			<p data-position-defense>{activePosition.defense}</p>
		</div>
	</section>

	<p class="team-rule">
		<strong>Unser Merksatz:</strong> Mit dem Ball machen wir das Feld groß. Gegen den Ball machen wir es
		klein.
	</p>
</section>

<script>
	function initializeFormationBoards() {
		const boards = document.querySelectorAll<HTMLElement>('[data-formation-board]');

		for (const board of boards) {
			if (board.dataset.initialized === 'true') continue;
			board.dataset.initialized = 'true';

			const buttons = board.querySelectorAll<HTMLButtonElement>('[data-position]');
			const label = board.querySelector<HTMLElement>('[data-position-label]');
			const responsibility = board.querySelector<HTMLElement>('[data-position-responsibility]');
			const offense = board.querySelector<HTMLElement>('[data-position-offense]');
			const defense = board.querySelector<HTMLElement>('[data-position-defense]');

			for (const button of buttons) {
				button.addEventListener('click', () => {
					for (const otherButton of buttons) {
						const isActive = otherButton === button;
						otherButton.classList.toggle('active', isActive);
						otherButton.setAttribute('aria-pressed', String(isActive));
					}

					if (label) label.textContent = button.dataset.label ?? '';
					if (responsibility) responsibility.textContent = button.dataset.responsibility ?? '';
					if (offense) offense.textContent = button.dataset.offense ?? '';
					if (defense) defense.textContent = button.dataset.defense ?? '';
				});
			}
		}
	}

	initializeFormationBoards();
	document.addEventListener('astro:page-load', initializeFormationBoards);
</script>

<style>
	.formation-board {
		display: grid;
		gap: 0.9rem;
		min-width: 0;
	}

	.board-heading {
		display: flex;
		padding: 0.7rem 0.85rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-radius: 0.4rem;
		color: white;
		background: var(--black);
		box-shadow: var(--shadow);
	}

	.board-heading p,
	.board-heading strong {
		margin: 0;
		font-size: 0.74rem;
	}

	.board-heading p {
		color: #bde4c8;
		font-weight: 900;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.board-heading p span {
		font-size: 1rem;
	}

	.board-heading strong {
		text-align: right;
	}

	.pitch {
		position: relative;
		width: 100%;
		height: min(112vw, 31rem);
		min-height: 24rem;
		border: 0.35rem solid #e8f3e9;
		border-radius: 0.35rem;
		background:
			repeating-linear-gradient(
				90deg,
				rgb(255 255 255 / 4%) 0,
				rgb(255 255 255 / 4%) 12.5%,
				rgb(0 0 0 / 4%) 12.5%,
				rgb(0 0 0 / 4%) 25%
			),
			#347448;
		box-shadow:
			inset 0 0 0 0.2rem rgb(255 255 255 / 35%),
			var(--shadow);
		overflow: hidden;
	}

	.halfway-line {
		position: absolute;
		top: 50%;
		right: 0;
		left: 0;
		border-top: 2px solid rgb(255 255 255 / 70%);
	}

	.center-circle {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 5rem;
		height: 5rem;
		border: 2px solid rgb(255 255 255 / 70%);
		border-radius: 50%;
		transform: translate(-50%, -50%);
	}

	.center-circle::after {
		content: "";
		position: absolute;
		top: 50%;
		left: 50%;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 50%;
		background: rgb(255 255 255 / 75%);
		transform: translate(-50%, -50%);
	}

	.penalty-area {
		position: absolute;
		left: 50%;
		width: 55%;
		height: 17%;
		border: 2px solid rgb(255 255 255 / 70%);
		transform: translateX(-50%);
	}

	.opponent-area {
		top: -2px;
	}

	.own-area {
		bottom: -2px;
	}

	.goal {
		position: absolute;
		z-index: 1;
		left: 50%;
		width: 28%;
		height: 2.5%;
		border: 2px solid rgb(255 255 255 / 82%);
		transform: translateX(-50%);
	}

	.opponent-goal {
		top: -2px;
		border-top: 0;
	}

	.own-goal {
		bottom: -2px;
		border-bottom: 0;
	}

	.player-position {
		position: absolute;
		z-index: 3;
		top: var(--y);
		left: var(--x);
		display: grid;
		width: 4.8rem;
		min-height: 4.3rem;
		padding: 0;
		place-items: center;
		border: 0;
		color: var(--black);
		background: transparent;
		cursor: pointer;
		transform: translate(-50%, -50%);
	}

	.player-position > span {
		display: grid;
		width: 2.9rem;
		height: 2.9rem;
		place-items: center;
		border: 0.18rem solid white;
		border-radius: 50%;
		background: #fffdf4;
		box-shadow: 0 0.25rem 0.55rem rgb(0 0 0 / 32%);
		font-size: 0.77rem;
		font-weight: 950;
		transition:
			color 150ms ease,
			background 150ms ease,
			transform 150ms ease;
	}

	.player-position small {
		padding: 0.16rem 0.3rem;
		border-radius: 999px;
		color: white;
		background: rgb(17 17 17 / 82%);
		font-size: 0.58rem;
		font-weight: 850;
		line-height: 1.1;
		white-space: nowrap;
	}

	.player-position.active > span {
		color: white;
		background: var(--accent);
		transform: scale(1.14);
	}

	.player-position.active small {
		background: var(--accent-dark);
	}

	.player-position:focus-visible {
		border-radius: 0.35rem;
		outline-offset: 0;
	}

	.position-details {
		position: relative;
		display: grid;
		gap: 0.7rem;
		padding: 1.15rem 1rem 1rem;
		border-top: 0.4rem solid var(--accent);
		border-radius: 0.35rem;
		background:
			linear-gradient(rgb(30 30 30 / 6%) 1px, transparent 1px),
			var(--paper);
		background-size: 100% 1.6rem;
		box-shadow: var(--shadow);
	}

	.position-details::after {
		content: "";
		position: absolute;
		top: -0.75rem;
		right: 1.15rem;
		width: 3.6rem;
		height: 1rem;
		background: rgb(235 224 213 / 78%);
		transform: rotate(2deg);
	}

	.details-eyebrow {
		margin: 0;
		color: var(--accent-dark);
		font-size: 0.68rem;
		font-weight: 900;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.position-details h2 {
		margin: -0.35rem 0 0;
		font-family: ui-rounded, "Arial Rounded MT Bold", sans-serif;
		font-size: 1.55rem;
		line-height: 1.1;
	}

	.detail-block {
		padding: 0.75rem;
		border: 1px solid #ddd4c2;
		border-radius: 0.45rem;
		background: rgb(255 255 255 / 76%);
	}

	.detail-block h3 {
		margin: 0 0 0.3rem;
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.detail-block p {
		margin: 0;
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.offense {
		border-left: 0.3rem solid #2f8550;
	}

	.defense {
		border-left: 0.3rem solid var(--accent);
	}

	.team-rule {
		padding: 0.8rem 0.9rem;
		margin: 0;
		border: 1px dashed #ddc653;
		border-radius: 0.4rem;
		color: #4e421b;
		background: #fff1a6;
		font-size: 0.84rem;
		line-height: 1.45;
		transform: rotate(-0.25deg);
	}
</style>
