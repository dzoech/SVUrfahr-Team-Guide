---
import '@fontsource/caveat/latin-600.css';
import { Image } from 'astro:assets';
import clubLogo from '../assets/sv-urfahr-logo.png';
import teamScarf from '../assets/sv-urfahr-schal.png';
import SiteHeader from '../components/SiteHeader.astro';
import { pagePath, SITE } from '../config';
import { getUpcomingEvents } from '../lib/calendar';
import BaseLayout from '../layouts/BaseLayout.astro';

const [nextEvent] = await getUpcomingEvents(1);
const nextOpponent = nextEvent?.opponent?.replace(/\s+U11(?:\s+[AB])?$/, '');
const showKontaktCard = false;
const timeZone = 'Europe/Vienna';
const dateFormatter = new Intl.DateTimeFormat('de-AT', {
	weekday: 'short',
	day: '2-digit',
	month: 'short',
	timeZone,
});
const timeFormatter = new Intl.DateTimeFormat('de-AT', {
	hour: '2-digit',
	minute: '2-digit',
	timeZone,
});
---

<BaseLayout>
	<SiteHeader />

	<div class="folder-intro" data-folder-intro>
		<button
			class="folder-intro-cover"
			type="button"
			aria-label="Mannschaftsmappe öffnen"
			data-folder-intro-open
		>
			<span class="folder-intro-tab">U11</span>
			<div class="folder-intro-label">
				<small>SV Urfahr 1912</small>
				<strong>Mannschafts-<br />mappe</strong>
				<em>Zum Öffnen tippen</em>
			</div>
			<span class="folder-coffee-liquid" aria-hidden="true"></span>
			<span class="folder-coffee-stain" aria-hidden="true"></span>
			<span class="folder-coffee-drops" aria-hidden="true"></span>
			<Image
				class="folder-logo-stamp"
				src={clubLogo}
				alt=""
				aria-hidden="true"
			/>
		</button>
	</div>
	<script is:inline data-astro-rerun>
		{
			const folderIntro = document.currentScript?.previousElementSibling;
			if (folderIntro instanceof HTMLElement) {
				const storageKey = 'sv-urfahr-guide:folder-intro-seen';
				const skipAnimationsClass = 'home-skip-entry';
				const openButton = folderIntro.querySelector('[data-folder-intro-open]');

				if (
					window.sessionStorage.getItem(storageKey) !== 'true' &&
					openButton instanceof HTMLButtonElement
				) {
					document.documentElement.classList.remove(skipAnimationsClass);
					document.documentElement.classList.add('folder-intro-pending');
					folderIntro.classList.add('active');
					openButton.addEventListener(
						'click',
						() => {
							window.sessionStorage.setItem(storageKey, 'true');

							if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
								document.documentElement.classList.remove('folder-intro-pending');
								folderIntro.remove();
								return;
							}

							folderIntro.classList.add('opening');
							window.setTimeout(() => {
								document.documentElement.classList.remove('folder-intro-pending');
								folderIntro.remove();
							}, 1950);
						},
						{ once: true },
					);
				} else {
					document.documentElement.classList.add(skipAnimationsClass);
					document.documentElement.classList.remove('folder-intro-pending');
					folderIntro.remove();
				}
			}
		}
	</script>

	<button
		class="team-scarf"
		type="button"
		aria-label="Fanschal nach unten fallen lassen"
		aria-pressed="false"
		data-team-scarf
		style="appearance: none; border: 0; background: transparent; padding: 0;"
	>
		<Image
			src={teamScarf}
			alt=""
			decoding="async"
		/>
	</button>
	<script is:inline data-astro-rerun>
		{
			const scarf = document.currentScript?.previousElementSibling;
			if (
				scarf instanceof HTMLButtonElement &&
				window.localStorage.getItem('sv-urfahr-guide:scarf-state') === 'dropped'
			) {
				scarf.classList.add('dropped-resting');
				scarf.setAttribute('aria-pressed', 'true');
				scarf.setAttribute('aria-label', 'Fanschal ausblenden');
			}
		}
	</script>

	<main class="home" transition:animate="none">
		<header class="welcome">
			<p>Willkommen bei der</p>
			<h1>{SITE.title}</h1>
			<div>Was brauchst du gerade?</div>
		</header>

		<section class="season-updates" aria-labelledby="season-updates-title">
			<div class="updates-masthead" aria-hidden="true">
				<span>SV Urfahr 1912</span>
				<strong>Mannschaftsblatt</strong>
				<span>Sonderausgabe</span>
			</div>
			<p class="updates-label">Neu in dieser Saison</p>
			<h2 id="season-updates-title">Das ändert sich in der Organisation</h2>
			<ul>
				<li>
					<strong>Auswärtsfahrten:</strong> Eltern organisieren Anreise und Fahrgemeinschaften selbst.
					<a href={`${pagePath('aufgaben-eltern')}#01-puenktlichkeit`}>Mehr dazu →</a>
				</li>
				<li>
					<strong>Zu- und Absagen:</strong> Rückmeldungen laufen über die WhatsApp-Events.
					<a href={`${pagePath('faq')}#02-absage`}>Mehr dazu →</a>
				</li>
				<li>
					<strong>Kurzfristige Absagen:</strong> Das Kind ruft selbst beim Trainerteam an.
					<a href={`${pagePath('faq')}#02-absage`}>Fristen ansehen →</a>
				</li>
			</ul>
		</section>

		<nav class="desk-menu" aria-label="Bereiche der Mannschaftsmappe">
			<a class="menu-card calendar-card" href={pagePath('termine')} style="--order: 0">
				<span class="card-label">Nächstes Match</span>
				{nextEvent ? (
					<>
						<span class="calendar-date">
							<strong>{dateFormatter.format(nextEvent.start)}</strong>
							<small>{nextEvent.allDay ? 'Ganztägig' : timeFormatter.format(nextEvent.start)}</small>
						</span>
						<span
							class:list={[
								'card-title',
								{ 'card-fixture': nextEvent.matchSide && nextOpponent },
							]}
						>
							{nextEvent.matchSide && nextOpponent ? (
								<>
									{nextEvent.matchSide === 'home' && (
										<Image class="card-fixture-badge" src={clubLogo} alt="SV Urfahr" />
									)}
									<span>
										{nextEvent.matchSide === 'home'
											? `vs ${nextOpponent}`
											: `${nextOpponent} vs`}
									</span>
									{nextEvent.matchSide === 'away' && (
										<Image class="card-fixture-badge" src={clubLogo} alt="SV Urfahr" />
									)}
								</>
							) : (
								nextEvent.title
							)}
						</span>
					</>
				) : (
					<span class="card-title">Meisterschaftskalender öffnen</span>
				)}
				<span class="card-action">Alle Spiele <span aria-hidden="true">→</span></span>
			</a>

			<section class="practice-card" aria-labelledby="practice-title" style="--order: 1">
				<h2 id="practice-title">Trainingszeiten</h2>
				<div class="practice-times">
					<p><span>Montag</span><strong>17:00</strong></p>
					<p><span>Donnerstag</span><strong>17:00</strong></p>
				</div>
				<p class="practice-rsvp">
					<strong>Teilnahme & Absage:</strong> Rückmeldungen laufen über die WhatsApp-Events.
					<a href={`${pagePath('faq')}#02-absage`}>Regeln ansehen →</a>
				</p>
				<div class="practice-bottom">
					<div class="postit-wrap">
						<span class="paper-clip" aria-hidden="true"></span>
						<aside class="attendance-note">
							Wer<br />nicht absagt, <strong>ist da</strong>
						</aside>
					</div>
					<p class="practice-details">
						Treffpunkt 15 Minuten vor Trainingsbeginn, fertig umgezogen am Platz. Das Training dauert
						bis ca. 18:30 Uhr, danach räumen wir gemeinsam zusammen.
					</p>
				</div>
			</section>

			<a class="menu-card folder-card parents" href={pagePath('aufgaben-eltern')} style="--order: 3">
				<span class="object-mark" aria-hidden="true">E</span>
				<span class="card-title">Aufgaben der Eltern</span>
				<span class="card-action">Nachlesen →</span>
			</a>

			<a class="menu-card folder-card children" href={pagePath('aufgaben-kinder')} style="--order: 4">
				<span class="object-mark" aria-hidden="true">K</span>
				<span class="card-title">Aufgaben der Kinder</span>
				<span class="card-action">Nachlesen →</span>
			</a>

			<a class="menu-card formation-card" href={pagePath('aufstellung')} style="--order: 5">
				<span class="object-mark formation-mark" aria-hidden="true">6+1</span>
				<span class="card-title">Positionen am Feld</span>
				<span class="card-action">Taktiktafel öffnen →</span>
			</a>

			<a class="menu-card quiz-link-card" href={pagePath('fussballbegriffe')} style="--order: 6">
				<span class="object-mark quiz-mark" aria-hidden="true">ABC</span>
				<span class="card-title">Fußballbegriffe-Quiz</span>
				<span class="card-action">Quiz starten →</span>
			</a>

			<a class="menu-card index-card" href={pagePath('faq')} style="--order: 7">
				<span class="object-mark" aria-hidden="true">?</span>
				<span class="card-title">Häufige Fragen</span>
				<span class="card-action">Antworten →</span>
			</a>

			{showKontaktCard && (
				<a class="menu-card note-card" href={pagePath('kontakt')} style="--order: 8">
					<span class="object-mark" aria-hidden="true">i</span>
					<span class="card-title">Kontakt</span>
					<span class="card-action">Öffnen →</span>
				</a>
			)}

			<a class="menu-card newcomer-card" href={pagePath('neu-im-team')} style="--order: 9">
				<span class="object-mark" aria-hidden="true">★</span>
				<span class="card-title">Neu im Team?</span>
				<span class="card-action">Zur Checkliste →</span>
			</a>
		</nav>

		<footer>
			<span>{SITE.team}</span>
			<button type="button" data-replay-folder-intro>Mappe schließen</button>
		</footer>
	</main>
</BaseLayout>

<script>
	function initializeFolderIntroReplay() {
		const replayLinks = document.querySelectorAll<HTMLButtonElement>('[data-replay-folder-intro]');

		for (const replayLink of replayLinks) {
			if (replayLink.dataset.initialized === 'true') continue;
			replayLink.dataset.initialized = 'true';

			replayLink.addEventListener('click', () => {
				window.sessionStorage.removeItem('sv-urfahr-guide:folder-intro-seen');
				window.location.reload();
			});
		}
	}

	function createTeamScarfExplosion(scarf: HTMLButtonElement) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

		document.querySelectorAll('[data-scarf-confetti]').forEach((explosion) => explosion.remove());

		const scarfBounds = scarf.getBoundingClientRect();
		const scarfImage = scarf.querySelector<HTMLImageElement>('img');
		const explosion = document.createElement('div');
		const colors = ['#ed1c24', '#c8101e', '#ff3038', '#090909', '#171717', '#242020'];
		const particleCount = 320;
		const travelDistance = Math.max(window.innerWidth, window.innerHeight);

		explosion.className = 'scarf-confetti-explosion';
		explosion.dataset.scarfConfetti = '';
		explosion.setAttribute('aria-hidden', 'true');
		explosion.style.left = `${scarfBounds.left + scarfBounds.width / 2}px`;
		explosion.style.top = `${scarfBounds.top + scarfBounds.height / 2}px`;

		if (scarfImage) {
			const columns = 16;
			const rows = 3;
			const shardWidth = scarfBounds.width / columns;
			const shardHeight = scarfBounds.height / rows;
			const imageUrl = scarfImage.currentSrc || scarfImage.src;

			for (let row = 0; row < rows; row += 1) {
				for (let column = 0; column < columns; column += 1) {
					const shard = document.createElement('i');
					const startX = column * shardWidth - scarfBounds.width / 2;
					const startY = row * shardHeight - scarfBounds.height / 2;
					const angle = -Math.PI + Math.random() * Math.PI;
					const distance = travelDistance * (0.18 + Math.random() * 0.32);
					const travelX = Math.cos(angle) * distance;
					const travelY = Math.sin(angle) * distance * 0.7;
					const spin = (Math.random() < 0.5 ? -1 : 1) * (240 + Math.random() * 720);

					shard.className = 'scarf-shard';
					shard.style.width = `${shardWidth + 0.7}px`;
					shard.style.height = `${shardHeight + 0.7}px`;
					shard.style.backgroundImage = `url("${imageUrl}")`;
					shard.style.backgroundSize = `${scarfBounds.width}px ${scarfBounds.height}px`;
					shard.style.backgroundPosition = `${-column * shardWidth}px ${-row * shardHeight}px`;
					shard.style.setProperty('--start-x', `${startX}px`);
					shard.style.setProperty('--start-y', `${startY}px`);
					shard.style.setProperty('--shard-mid-x', `${startX + travelX * 0.58}px`);
					shard.style.setProperty('--shard-mid-y', `${startY + travelY * 0.58 - 22}px`);
					shard.style.setProperty('--shard-end-x', `${startX + travelX * 1.12}px`);
					shard.style.setProperty(
						'--shard-end-y',
						`${startY + travelY + window.innerHeight * (0.14 + Math.random() * 0.2)}px`,
					);
					shard.style.setProperty('--shard-mid-spin', `${spin * 0.55}deg`);
					shard.style.setProperty('--shard-spin', `${spin}deg`);
					shard.style.setProperty('--shard-delay', `${Math.random() * 35}ms`);
					shard.style.setProperty('--shard-duration', `${820 + Math.random() * 360}ms`);
					explosion.append(shard);
				}
			}
		}

		for (let index = 0; index < particleCount; index += 1) {
			const particle = document.createElement('i');
			const angle = -Math.PI + Math.random() * Math.PI;
			const distance = travelDistance * (0.3 + Math.random() * 0.5);
			const burstX = Math.cos(angle) * distance;
			const burstY = Math.sin(angle) * distance * 0.78 - Math.random() * 35;
			const fallX = burstX * (1.05 + Math.random() * 0.18) + (Math.random() - 0.5) * 90;
			const fallY = burstY + window.innerHeight * (0.2 + Math.random() * 0.38);
			const spin = (Math.random() < 0.5 ? -1 : 1) * (540 + Math.random() * 1260);
			const width = 5 + Math.random() * 9;
			const height = width * (1.25 + Math.random() * 1.25);

			particle.className = 'scarf-confetti';
			particle.style.setProperty('--burst-x', `${burstX}px`);
			particle.style.setProperty('--burst-y', `${burstY}px`);
			particle.style.setProperty('--fall-x', `${fallX}px`);
			particle.style.setProperty('--fall-y', `${fallY}px`);
			particle.style.setProperty('--mid-spin', `${spin * 0.58}deg`);
			particle.style.setProperty('--spin', `${spin}deg`);
			particle.style.setProperty('--piece-width', `${width}px`);
			particle.style.setProperty('--piece-height', `${height}px`);
			particle.style.setProperty('--piece-color', colors[index % colors.length]);
			particle.style.setProperty('--delay', `${Math.random() * 70}ms`);
			particle.style.setProperty('--duration', `${900 + Math.random() * 500}ms`);
			explosion.append(particle);
		}

		document.body.append(explosion);
		window.setTimeout(() => explosion.remove(), 1600);
	}

	function initializeTeamScarf() {
		const scarves = document.querySelectorAll<HTMLButtonElement>('[data-team-scarf]');
		const storageKey = 'sv-urfahr-guide:scarf-state';

		for (const scarf of scarves) {
			if (
				window.localStorage.getItem(storageKey) === 'dropped' &&
				!scarf.classList.contains('dropped-resting')
			) {
				scarf.classList.add('dropped-resting');
				scarf.setAttribute('aria-pressed', 'true');
				scarf.setAttribute('aria-label', 'Fanschal ausblenden');
			}

			if (scarf.dataset.initialized === 'true') continue;
			scarf.dataset.initialized = 'true';

			scarf.addEventListener('click', () => {
				if (scarf.classList.contains('dropped-resting')) {
					const dismissal = Math.random() < 0.5 ? 'exploding' : 'flying-away';
					if (dismissal === 'exploding') createTeamScarfExplosion(scarf);

					window.localStorage.removeItem(storageKey);
					scarf.classList.remove('dropped-resting');
					scarf.classList.add('dismissing', dismissal);
					scarf.setAttribute('aria-pressed', 'false');
					scarf.setAttribute('aria-label', 'Fanschal wird ausgeblendet');
					return;
				}

				if (
					!scarf.classList.contains('dropped') &&
					!scarf.classList.contains('dismissing')
				) {
					window.localStorage.setItem(storageKey, 'dropped');
					scarf.classList.add('dropped');
					scarf.setAttribute('aria-pressed', 'true');
					scarf.setAttribute('aria-label', 'Fanschal fällt nach unten');
				}
			});

			scarf.addEventListener('animationend', (event) => {
				if (event.animationName === 'scarf-drop-bottom') {
					scarf.classList.remove('dropped');
					scarf.classList.add('dropped-resting');
					scarf.setAttribute('aria-label', 'Fanschal ausblenden');
				}

				if (
					event.animationName === 'scarf-dismiss-explosion' ||
					event.animationName === 'scarf-dismiss-flyaway'
				) {
					scarf.classList.remove('dismissing', 'exploding', 'flying-away');
					scarf.hidden = true;
				}
			});
		}
	}

	function initializeHomePage() {
		initializeFolderIntroReplay();
		initializeTeamScarf();
	}

	initializeHomePage();
	document.addEventListener('astro:page-load', initializeHomePage);
</script>

<style>
	.folder-intro {
		display: none;
	}

	.folder-intro.active {
		position: fixed;
		z-index: 100;
		inset: 0;
		display: block;
		overflow: hidden;
		background: #2a1113;
		perspective: 70rem;
	}

	.folder-intro.opening {
		pointer-events: none;
		animation: folder-intro-finish 1.9s ease-in both;
	}

	:global(html.folder-intro-pending) .team-scarf:not(.dropped-resting),
	:global(html.folder-intro-pending) .team-scarf:not(.dropped-resting) img {
		visibility: hidden;
		animation: none;
	}

	.folder-intro-cover {
		position: absolute;
		z-index: 2;
		inset: 5svh 3vw -8svh;
		width: auto;
		padding: 0;
		border: 0.12rem solid rgb(78 42 20 / 45%);
		border-radius: 0.45rem 0.45rem 1rem 1rem;
		appearance: none;
		background:
			linear-gradient(102deg, rgb(255 255 255 / 8%), transparent 26% 71%, rgb(74 35 16 / 10%)),
			repeating-linear-gradient(88deg, transparent 0 7px, rgb(86 46 22 / 5%) 8px 9px),
			#b9824c;
		box-shadow:
			inset 0 0 0 0.2rem rgb(255 255 255 / 7%),
			0 -0.4rem 1.4rem rgb(0 0 0 / 28%),
			0 1.5rem 3rem rgb(0 0 0 / 45%);
		color: inherit;
		cursor: pointer;
		transform-origin: center bottom;
		transform-style: preserve-3d;
		backface-visibility: hidden;
	}

	.folder-intro.opening .folder-intro-cover {
		animation: folder-cover-open 1.6s cubic-bezier(0.3, 0.05, 0.2, 1) 120ms both;
	}

	.folder-intro-cover::before {
		content: "";
		position: absolute;
		top: -2.7rem;
		left: 1rem;
		width: 42%;
		height: 3rem;
		border: inherit;
		border-bottom: 0;
		border-radius: 0.7rem 1.1rem 0 0;
		background: #b9824c;
	}

	.folder-intro-tab {
		position: absolute;
		z-index: 1;
		top: -2rem;
		left: 2rem;
		color: rgb(61 31 17 / 78%);
		font-size: 0.82rem;
		font-weight: 950;
		letter-spacing: 0.12em;
	}

	.folder-intro-label {
		position: absolute;
		top: 35%;
		left: 50%;
		display: grid;
		width: min(calc(100% - 3rem), 21rem);
		min-width: 0;
		gap: 0.3rem;
		padding: 1.1rem 0.9rem 1rem;
		overflow: hidden;
		border: 0.38rem double #a91820;
		color: #211b18;
		background: #f5e8c9;
		box-shadow: 0 0.35rem 0.7rem rgb(68 36 17 / 28%);
		text-align: center;
		text-transform: uppercase;
		transform: translate(-50%, -50%) rotate(-1.2deg);
	}

	.folder-intro-label small {
		color: #a91820;
		font-size: 0.72rem;
		font-weight: 950;
		letter-spacing: 0.1em;
	}

	.folder-intro-label strong {
		min-width: 0;
		font-family: ui-rounded, "Arial Rounded MT Bold", sans-serif;
		font-size: clamp(1.55rem, 8vw, 2.35rem);
		line-height: 0.95;
		letter-spacing: -0.045em;
	}

	.folder-intro-label em {
		margin-top: 0.3rem;
		color: rgb(33 27 24 / 65%);
		font-size: 0.68rem;
		font-style: normal;
		font-weight: 850;
		letter-spacing: 0.08em;
	}

	.folder-coffee-stain {
		position: absolute;
		right: -7%;
		bottom: 13%;
		width: clamp(8.3rem, 40vw, 10.9rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: conic-gradient(
			from 18deg,
			rgb(45 17 6 / 68%) 0 24%,
			rgb(45 17 6 / 48%) 27% 40%,
			transparent 41% 43%,
			rgb(45 17 6 / 64%) 44% 78%,
			rgb(45 17 6 / 42%) 81% 91%,
			transparent 92% 94%,
			rgb(45 17 6 / 62%) 95% 100%
		);
		filter: blur(0.055rem) drop-shadow(0 0 0.14rem rgb(45 17 6 / 28%));
		-webkit-mask: radial-gradient(circle, transparent 0 54%, #000 56% 62%, transparent 65%);
		mask: radial-gradient(circle, transparent 0 54%, #000 56% 62%, transparent 65%);
		mix-blend-mode: multiply;
		opacity: 0.76;
		transform: rotate(12deg);
	}

	.folder-coffee-liquid {
		position: absolute;
		right: -6%;
		bottom: 7%;
		width: clamp(8rem, 38vw, 10.5rem);
		height: clamp(4.5rem, 21vw, 6rem);
		border-radius: 58% 42% 64% 36% / 48% 62% 38% 52%;
		background:
			radial-gradient(ellipse at 40% 46%, rgb(43 16 6 / 42%) 0 34%, rgb(43 16 6 / 25%) 48%, transparent 69%),
			radial-gradient(ellipse at 72% 62%, rgb(43 16 6 / 46%) 0 17%, transparent 44%),
			radial-gradient(circle at 15% 72%, rgb(43 16 6 / 38%) 0 8%, transparent 12%);
		box-shadow:
			inset 0.35rem -0.25rem 0.5rem rgb(32 11 3 / 24%),
			-1.1rem 0.65rem 0 -0.72rem rgb(43 16 6 / 32%);
