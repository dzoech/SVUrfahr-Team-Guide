		height: auto;
		filter:
			grayscale(1)
			brightness(3.4)
			contrast(9)
			drop-shadow(0.065rem 0 0 #171515)
			drop-shadow(-0.065rem 0 0 #171515)
			drop-shadow(0 0.065rem 0 #171515)
			drop-shadow(0 -0.065rem 0 #171515);
		mix-blend-mode: multiply;
		opacity: 0.68;
		transform: rotate(-13deg);
