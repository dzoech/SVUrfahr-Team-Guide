---
import '@fontsource/caveat/latin-600.css';
import SiteHeader from '../components/SiteHeader.astro';
import { pagePath, SITE } from '../config';
import { getUpcomingEvents } from '../lib/calendar';
import BaseLayout from '../layouts/BaseLayout.astro';

const [nextEvent] = await getUpcomingEvents(1);
const timeZone = 'Europe/Vienna';
const dateFormatter = new Intl.DateTimeFormat('de-AT', {
	weekday: 'short',
	day: '2-digit',
	month: 'short',
	timeZone,
});
const timeFormatter = new Intl.DateTimeFormat('de-AT', {
	hour: '2-digit',
	minute: '2-digit',
	timeZone,
});
---

<BaseLayout>
	<SiteHeader />

	<main class="home" transition:animate="slide">
		<header class="welcome">
			<p>Willkommen bei der</p>
			<h1>{SITE.title}</h1>
			<div>Was brauchst du gerade?</div>
		</header>

		<nav class="desk-menu" aria-label="Bereiche der Mannschaftsmappe">
			<a class="menu-card calendar-card" href={pagePath('termine')} style="--order: 0">
				<span class="card-label">Nächster Termin</span>
				{nextEvent ? (
					<>
						<span class="calendar-date">
							<strong>{dateFormatter.format(nextEvent.start)}</strong>
							<small>{nextEvent.allDay ? 'Ganztägig' : timeFormatter.format(nextEvent.start)}</small>
						</span>
						<span class="card-title">{nextEvent.title}</span>
					</>
				) : (
					<span class="card-title">Mannschaftskalender öffnen</span>
				)}
				<span class="card-action">Alle Termine <span aria-hidden="true">→</span></span>
			</a>

			<section class="practice-card" aria-labelledby="practice-title" style="--order: 1">
				<h2 id="practice-title">Trainingszeiten</h2>
				<div class="practice-times">
					<p><span>Montag</span><strong>17:00</strong></p>
					<p><span>Donnerstag</span><strong>17:00</strong></p>
				</div>
				<div class="practice-bottom">
					<div class="postit-wrap">
						<span class="paper-clip" aria-hidden="true"></span>
						<aside class="attendance-note">
							Wer nicht absagt,<br /><strong>ist da</strong>
						</aside>
					</div>
					<p class="practice-details">
						Treffpunkt 15 Minuten vor Trainingsbeginn, fertig umgezogen am Platz. Das Training dauert
						bis ca. 18:30 Uhr, danach räumen wir gemeinsam zusammen.
					</p>
				</div>
			</section>

			<a class="menu-card folder-card parents" href={pagePath('aufgaben-eltern')} style="--order: 3">
				<span class="object-mark" aria-hidden="true">E</span>
				<span class="card-title">Aufgaben der Eltern</span>
				<span class="card-action">Nachlesen →</span>
			</a>

			<a class="menu-card folder-card children" href={pagePath('aufgaben-kinder')} style="--order: 4">
				<span class="object-mark" aria-hidden="true">K</span>
				<span class="card-title">Aufgaben der Kinder</span>
				<span class="card-action">Nachlesen →</span>
			</a>

			<a class="menu-card index-card" href={pagePath('faq')} style="--order: 5">
				<span class="object-mark" aria-hidden="true">?</span>
				<span class="card-title">Häufige Fragen</span>
				<span class="card-action">Antworten →</span>
			</a>

			<a class="menu-card note-card" href={pagePath('kontakt')} style="--order: 6">
				<span class="object-mark" aria-hidden="true">i</span>
				<span class="card-title">Kontakt</span>
				<span class="card-action">Öffnen →</span>
			</a>

			<a class="new-team-link" href={pagePath('neu-im-team')} style="--order: 7">
				<span>
					<strong>Neu im Team?</strong>
					<small>Hier geht es zur einmaligen Start-Checkliste.</small>
				</span>
				<span aria-hidden="true">→</span>
			</a>
		</nav>

		<footer>{SITE.team}</footer>
	</main>
</BaseLayout>

<style>
	.home {
		display: grid;
		width: min(100%, 30rem);
		min-height: calc(100svh - 4.35rem);
		gap: 1.1rem;
		padding:
			1rem
			max(0.85rem, env(safe-area-inset-right))
			max(1.5rem, env(safe-area-inset-bottom))
			max(0.85rem, env(safe-area-inset-left));
		margin-inline: auto;
		overflow-x: clip;
	}

	.welcome {
		position: relative;
		padding: 1.15rem 1.1rem 1.2rem;
		border-left: 0.35rem solid var(--accent);
		color: white;
		background: rgb(15 15 15 / 90%);
		box-shadow: var(--shadow);
		transform: rotate(-0.25deg);
		animation: desk-drop 420ms cubic-bezier(0.2, 0.8, 0.25, 1) both;
	}

	.welcome::after {
		content: "";
		position: absolute;
		top: -0.45rem;
		right: 1.1rem;
		width: 4.8rem;
		height: 1.2rem;
		background: rgb(235 224 213 / 70%);
		transform: rotate(3deg);
	}

	.welcome p {
		margin: 0 0 0.2rem;
		color: #ff7d81;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: ui-rounded, "Arial Rounded MT Bold", sans-serif;
		font-size: clamp(2rem, 10vw, 2.65rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.welcome div {
		margin-top: 0.5rem;
		color: rgb(255 255 255 / 70%);
		font-size: 0.92rem;
	}

	.desk-menu {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 0.85rem;
	}

	.menu-card,
	.new-team-link,
	.practice-card {
		min-width: 0;
		animation: desk-drop 430ms cubic-bezier(0.2, 0.8, 0.25, 1) both;
		animation-delay: calc(var(--order) * 55ms + 80ms);
	}

	.menu-card {
		position: relative;
		display: flex;
		min-height: 8.4rem;
		padding: 1rem;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.6rem;
		border-radius: 0.35rem;
		color: var(--ink);
		background: var(--paper);
		box-shadow: var(--shadow);
		text-decoration: none;
		overflow: hidden;
	}

	.menu-card:active {
		transform: scale(0.98);
	}

	.calendar-card {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 4.6rem minmax(0, 1fr);
		min-height: 8.2rem;
		padding: 1rem 1rem 0.9rem;
		align-items: center;
		border-top: 0.45rem solid var(--accent);
		background:
			linear-gradient(rgb(68 99 127 / 10%) 1px, transparent 1px),
			var(--paper);
		background-size: 100% 1.55rem;
		transform: rotate(0.2deg);
	}

	.card-label {
		grid-column: 1 / -1;
		color: var(--accent);
		font-size: 0.7rem;
		font-weight: 950;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.calendar-date {
		display: grid;
		min-height: 3.8rem;
		place-content: center;
		border-right: 2px solid var(--accent);
		color: var(--accent-dark);
		text-align: center;
		text-transform: uppercase;
	}

	.calendar-date strong {
		font-size: 0.77rem;
		line-height: 1.15;
	}

	.calendar-date small {
		margin-top: 0.25rem;
		font-size: 0.75rem;
		font-weight: 850;
	}

	.card-title {
		min-width: 0;
		font-family: ui-rounded, "Arial Rounded MT Bold", sans-serif;
		font-size: 1.03rem;
		font-weight: 900;
		line-height: 1.25;
		overflow-wrap: anywhere;
	}

	.calendar-card .card-title {
		padding-left: 0.8rem;
		font-size: 1.12rem;
	}

	.card-action {
		color: var(--accent-dark);
		font-size: 0.75rem;
		font-weight: 850;
	}

	.calendar-card .card-action {
		grid-column: 2;
		padding-left: 0.8rem;
	}

	.practice-card {
		position: relative;
		grid-column: 1 / -1;
		display: grid;
		gap: 0.7rem;
		padding: 1rem 1rem 0.35rem;
		border-left: 0.45rem solid var(--accent);
		border-radius: 0.35rem;
		color: var(--ink);
		background:
			linear-gradient(rgb(30 30 30 / 6%) 1px, transparent 1px),
			#fff9e8;
		background-size: 100% 1.55rem;
		box-shadow: var(--shadow);
		transform: rotate(-0.2deg);
	}

	.practice-card::after {
		content: "";
		position: absolute;
		top: -0.45rem;
		right: 1.2rem;
		width: 3.8rem;
		height: 1rem;
		background: rgb(235 224 213 / 72%);
		transform: rotate(2deg);
	}

	.practice-card h2 {
		margin: 0;
		color: var(--accent-dark);
		font-family: ui-rounded, "Arial Rounded MT Bold", sans-serif;
		font-size: 1.05rem;
		letter-spacing: 0.02em;
	}

	.practice-times {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
	}

	.practice-times p {
		display: grid;
		gap: 0.1rem;
		padding: 0.55rem 0.65rem;
		margin: 0;
		border: 1px solid #d5c7ae;
		border-radius: 0.35rem;
		background: rgb(255 255 255 / 70%);
	}

	.practice-times span {
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 850;
		text-transform: uppercase;
	}

	.practice-times strong {
		font-size: 1.25rem;
		line-height: 1.1;
	}

	.practice-details {
		margin: 0;
		color: var(--muted);
		font-size: 0.84rem;
		line-height: 1.45;
	}

	.practice-bottom {
		display: flow-root;
	}

	.postit-wrap {
		position: relative;
		z-index: 2;
		top: 0.8rem;
		right: -0.35rem;
		float: right;
		width: min(8.75rem, 52%);
		margin-left: 0.65rem;
	}

	.postit-wrap::after {
		content: "";
		position: absolute;
		z-index: 3;
		top: 0.72rem;
		right: -1.15rem;
		width: 2.82rem;
		height: 0.96rem;
		border: 0.19rem solid #777773;
		border-radius: 0.66rem;
		filter: drop-shadow(0.08rem 0.12rem 0.08rem rgb(0 0 0 / 30%));
		pointer-events: none;
		transform: rotate(5deg);
	}

	.attendance-note {
		position: relative;
		z-index: 2;
		display: grid;
		width: 100%;
		min-height: 5.4rem;
		padding: 0.75rem;
		place-content: center;
		color: #242014;
		background: #eed66f;
		clip-path: polygon(2% 1%, 98% 0, 100% 94%, 96% 100%, 71% 98%, 48% 100%, 22% 97%, 1% 100%, 0 7%);
		filter: drop-shadow(0.2rem 0.4rem 0.35rem rgb(0 0 0 / 30%));
		font-family: "Caveat", cursive;
		font-size: 1.45rem;
		font-weight: 600;
		line-height: 1.05;
		pointer-events: none;
		text-align: center;
		text-shadow: 0.03em 0.03em 0 rgb(36 32 20 / 12%);
		transform: rotate(-2.5deg) skewX(-0.5deg);
	}

	.paper-clip {
		position: absolute;
		z-index: 1;
		top: 0.88rem;
		right: -0.9rem;
		width: 1.86rem;
		height: 0.3rem;
		border: 0.14rem solid #777773;
		border-radius: 0.42rem;
		clip-path: inset(0 0 0 86.5%);
		transform: rotate(5deg);
	}

	.attendance-note::before {
		content: "";
		position: absolute;
		inset: 0;
		box-shadow:
			inset 0.2rem 0 0.3rem rgb(62 51 17 / 10%),
			inset -0.15rem -0.2rem 0.3rem rgb(62 51 17 / 9%);
	}

	.attendance-note::after {
		content: "";
		position: absolute;
		top: 58%;
		right: 12%;
		left: 10%;
		height: 1px;
		background: rgb(62 51 17 / 14%);
		box-shadow:
			0 -1.65rem 0 rgb(62 51 17 / 8%),
			0 1.45rem 0 rgb(62 51 17 / 7%);
		transform: rotate(-5deg);
	}

	.attendance-note strong {
		color: inherit;
		font-size: 1.6rem;
		font-weight: 600;
	}

	.folder-card {
		border-top: 0.55rem solid var(--black);
	}

	.folder-card::before {
		content: "";
		position: absolute;
		top: -0.1rem;
		left: 0.8rem;
		width: 3.6rem;
		height: 0.75rem;
		border-radius: 0 0 0.35rem 0.35rem;
		background: var(--accent);
	}

	.object-mark {
		display: grid;
		width: 2.65rem;
		height: 2.65rem;
		place-items: center;
		border: 2px solid var(--accent);
		border-radius: 50%;
		color: var(--accent);
		font-size: 1.2rem;
		font-weight: 950;
	}

	.index-card {
		background:
			linear-gradient(rgb(40 40 40 / 7%) 1px, transparent 1px),
			#fff9dc;
		background-size: 100% 1.45rem;
		transform: rotate(-0.5deg);
	}

	.note-card {
		background: #f5e8e8;
		transform: rotate(0.7deg);
	}

	.note-card::after {
		content: "";
		position: absolute;
		right: 0;
		bottom: 0;
		border-style: solid;
		border-width: 0 0 1.2rem 1.2rem;
		border-color: transparent transparent #d8bfc0 transparent;
	}

	.new-team-link {
		grid-column: 1 / -1;
		display: flex;
		min-height: 4rem;
		padding: 0.75rem 0.95rem;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		border: 1px dashed rgb(255 255 255 / 36%);
		border-radius: 0.5rem;
		color: white;
		background: rgb(15 15 15 / 58%);
		text-decoration: none;
	}

	.new-team-link strong,
	.new-team-link small {
		display: block;
	}

	.new-team-link strong {
		font-size: 0.88rem;
	}

	.new-team-link small {
		margin-top: 0.15rem;
		color: rgb(255 255 255 / 62%);
		font-size: 0.72rem;
		line-height: 1.3;
	}

	.new-team-link > span:last-child {
		color: #ff777b;
		font-size: 1.25rem;
		font-weight: 900;
	}

	footer {
		color: rgb(255 255 255 / 55%);
		font-size: 0.72rem;
		font-weight: 700;
		text-align: center;
	}

	@keyframes desk-drop {
		from {
			opacity: 0;
			transform: translateY(2.5rem) rotate(2deg) scale(0.95);
		}
		to {
			opacity: 1;
		}
	}
</style>
