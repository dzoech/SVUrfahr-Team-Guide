	.welcome p {
		margin: 0 0 0.2rem;
		color: #ff7d81;
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: ui-rounded, "Arial Rounded MT Bold", sans-serif;
		font-size: clamp(2rem, 10vw, 2.65rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.welcome div {
		margin-top: 0.5rem;
		color: rgb(255 255 255 / 70%);
		font-size: 0.92rem;
	}

	.season-updates {
		position: relative;
		z-index: 2;
		padding: 0.7rem 0.8rem 0.9rem;
		border: 1px solid #4b463d;
		border-radius: 0.08rem;
		color: var(--ink);
		background:
			radial-gradient(circle at 18% 22%, rgb(77 59 34 / 5%) 0 0.05rem, transparent 0.08rem),
			radial-gradient(circle at 76% 68%, rgb(77 59 34 / 4%) 0 0.04rem, transparent 0.07rem),
			linear-gradient(96deg, transparent 48%, rgb(65 54 38 / 4%) 50%, transparent 52%),
			#f4edd9;
		background-size: 1.2rem 1.2rem, 1.6rem 1.6rem, 100% 100%, auto;
		box-shadow:
			0 0 0 0.22rem #f4edd9,
			0 0 0 0.29rem #4b463d,
			var(--shadow);
		transform: rotate(-0.2deg);
		animation: desk-drop 430ms cubic-bezier(0.2, 0.8, 0.25, 1) 55ms both;
	}

	.updates-masthead {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 0.45rem;
		padding: 0.3rem 0;
		align-items: center;
		border-top: 0.16rem solid #292621;
		border-bottom: 0.16rem solid #292621;
		font-family: Georgia, "Times New Roman", serif;
		text-transform: uppercase;
	}

	.updates-masthead span {
		font-size: 0.48rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.1;
		text-align: center;
	}

	.updates-masthead strong {
		font-size: 0.95rem;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.updates-label {
		width: fit-content;
		padding: 0.12rem 0.38rem;
		margin: 0.65rem auto 0.28rem;
		color: #f4edd9;
		background: var(--accent-dark);
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.season-updates h2 {
		max-width: 20rem;
		margin: 0 auto;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.45rem, 7vw, 1.8rem);
		font-weight: 900;
		line-height: 0.98;
		letter-spacing: -0.045em;
		text-align: center;
	}

	.season-updates ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		padding: 0.65rem 0 0;
		margin: 0.75rem 0 0;
		border-top: 0.18rem double #696156;
		list-style: none;
	}

	.season-updates li {
		padding: 0 0.55rem;
		border-right: 1px solid #9f9685;
		color: #37332d;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.7rem;
		line-height: 1.35;
	}

	.season-updates li:first-child {
		padding-left: 0;
	}

	.season-updates li:last-child {
		padding-right: 0;
		border-right: 0;
	}

	.season-updates strong {
		display: block;
		margin-bottom: 0.12rem;
		color: var(--ink);
		font-size: 0.72rem;
		line-height: 1.2;
	}

	.season-updates li a {
		display: inline-block;
		margin-top: 0.25rem;
		color: var(--accent-dark);
		font-family: system-ui, sans-serif;
		font-size: 0.62rem;
		font-weight: 850;
		white-space: nowrap;
	}

	@media (max-width: 22rem) {
		.season-updates ul {
			grid-template-columns: 1fr;
		}

		.season-updates li,
		.season-updates li:first-child,
		.season-updates li:last-child {
			padding: 0.5rem 0;
			border-right: 0;
			border-bottom: 1px solid #9f9685;
		}

		.season-updates li:first-child {
			padding-top: 0;
		}

		.season-updates li:last-child {
			padding-bottom: 0;
			border-bottom: 0;
		}
	}

	.team-scarf {
		position: fixed;
		z-index: 18;
		top: 16rem;
		left: calc(50% + min(50vw, 15rem));
		width: min(120vw, 36rem);
		padding: 0;
		border: 0;
		appearance: none;
		background: transparent;
		cursor: pointer;
		filter:
			drop-shadow(0.15rem 0.55rem 0.38rem rgb(0 0 0 / 40%))
			saturate(0.96);
		transform-origin: 50% 50%;
		animation: scarf-settle 1.15s cubic-bezier(0.2, 0.8, 0.25, 1) 280ms both;
		-webkit-tap-highlight-color: transparent;
	}

	.team-scarf img {
		display: block;
		width: 100%;
		height: auto;
		transform-origin: 100% 50%;
		animation:
			scarf-unfurl 1.05s cubic-bezier(0.3, 0.7, 0.2, 1) 320ms both,
			scarf-wave 6.5s linear 1.7s infinite;
		backface-visibility: hidden;
	}

	.team-scarf.dropped {
		cursor: default;
		pointer-events: none;
		animation: scarf-drop-bottom 1.6s linear both;
	}

	.team-scarf.dropped-resting {
		top: 100svh;
		left: 50%;
		width: min(calc(100vw - 1rem), 30rem);
		cursor: pointer;
		transform: translate(-50%, -80%) rotate(360deg);
		animation: none;
	}

	.team-scarf.dismissing {
		z-index: 30;
		pointer-events: none;
	}

	.team-scarf.dismissing.exploding {
		animation: scarf-dismiss-explosion 360ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.team-scarf.dismissing.flying-away {
		animation: scarf-dismiss-flyaway 1.15s linear both;
	}

	.team-scarf.dropped img,
	.team-scarf.dropped-resting img,
	.team-scarf.dismissing img {
		animation: none;
		transform: none;
	}

	.team-scarf.dropped ~ .home,
	.team-scarf.dropped-resting ~ .home,
	.team-scarf.dismissing ~ .home {
		padding-bottom: calc(10rem + env(safe-area-inset-bottom));
	}

	:global(.scarf-confetti-explosion) {
		position: fixed;
		z-index: 45;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	:global(.scarf-confetti) {
		position: absolute;
		top: 0;
		left: 0;
		width: var(--piece-width);
		height: var(--piece-height);
		border-radius: 0.08rem;
		background: var(--piece-color);
		box-shadow: 0 0.12rem 0.18rem rgb(0 0 0 / 28%);
		opacity: 0;
		transform-origin: center;
		animation: confetti-explode var(--duration) cubic-bezier(0.12, 0.58, 0.28, 1) var(--delay) both;
	}

	:global(.scarf-shard) {
		position: absolute;
		top: 0;
		left: 0;
		background-repeat: no-repeat;
		filter: drop-shadow(0 0.15rem 0.18rem rgb(0 0 0 / 30%));
		opacity: 0;
		transform-origin: center;
		animation:
			scarf-shard-explode var(--shard-duration) cubic-bezier(0.12, 0.58, 0.25, 1)
			var(--shard-delay) both;
	}

	:global(.scarf-confetti:nth-child(3n)) {
		border-radius: 50%;
	}

	:global(.scarf-confetti:nth-child(4n)) {
		clip-path: polygon(50% 0, 100% 100%, 0 100%);
	}

	.desk-menu {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
